assert(is_win)

# Cookie-name parsing and the recorder's switch names. These depend on the C++
# standard library alone, so the network service can read cookie names and
# recognise a recording browser without linking the recorder connection.
source_set("cookie_names") {
  sources = [
    "cookie_text.cc",
    "cookie_text.h",
    "recorder_switches.h",
  ]
}

component("recorder_bridge") {
  defines = [ "IS_RECORDER_BRIDGE_IMPL" ]

  sources = [
    "animation_settings.h",
    "browser_bridge.cc",
    "browser_bridge.h",
    "evidence_cost.cc",
    "evidence_cost.h",
    "evidence_queue.cc",
    "evidence_queue.h",
    "full_walks.cc",
    "full_walks.h",
    "layout_changes.cc",
    "layout_changes.h",
    "network_text.cc",
    "network_text.h",
    "recorder_protocol.cc",
    "recorder_protocol.h",
    "recreation_compositor_values.h",
    "recreation_paint_worklet_values.h",
    "recreation_preferences.h",
    "recreation_image_frames.h",
    "recreation_input.h",
    "v8_script_hook.h",
  ]

  public_deps = [ ":cookie_names" ]

  deps = [
    "//base",
    "//components/version_info",
    "//crypto",
  ]
}
