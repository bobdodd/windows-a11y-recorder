<Window x:Class="Recorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Recorder.App"
        Title="Windows Accessibility Recorder"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#171614"
        Foreground="#CDCCCA">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBackground" Color="#1C1B19" />
    <!-- Colours and contrast: docs/architecture/player-contrast.md. Edges
         are #75736F, 3.6 to 1 or more against the window's and panels'
         backgrounds, as WCAG 1.4.11 asks of a control's edges. -->
    <SolidColorBrush x:Key="PanelBorder" Color="#75736F" />
    <SolidColorBrush x:Key="MutedText" Color="#A09F9B" />
    <Style TargetType="GroupBox">
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="Foreground" Value="#CDCCCA" />
    </Style>
    <!-- No text colour for TextBlock or SelectableText: text takes the
         colour of what it is in, the window's #CDCCCA on the dark panels,
         and Windows' own text colour in the white lists, tree, and text
         boxes, which set it. A light colour here made their text 1.6 to 1
         on white (docs/architecture/player-contrast.md). Labels and check
         boxes keep one, as Windows' styles for them set a dark one. -->
    <!-- The white lists and tree in Windows' own text colour, so their text
         is dark whatever is around them: Windows' styles set it, and these
         say so here. -->
    <Style TargetType="ListBox">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    </Style>
    <Style TargetType="ListView">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="#CDCCCA" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#CDCCCA" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <!-- The splitters show keyboard focus: drawn in the highlight color,
         2 pixels wider on each side over their neighbours, with a tip
         naming the keys (docs/architecture/accessibility-preferences.md,
         "Visible focus and the Enter key"). The size and margin give the
         same layout size focused or not, so nothing moves. -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <!-- A previous or next change button of a properties row: a 44 by 44
         pixel target, the WCAG 2.5.5 size, for head pointer and eye
         tracking use. It does not take focus, so clicking it leaves the
         keyboard focus where it was. -->
    <Style x:Key="PropertyChangeButton" TargetType="Button">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <!-- A tab's button to open it in its own window: an icon, Windows'
         "open in new window" glyph, with the full text as its name and tip,
         as the owner asked (2026-10-12). A 44 by 44 pixel target, as the
         change buttons, and the single-click way to tear a tab out, for
         WCAG 2.5.7, as dragging the tab is the other way. -->
    <Style x:Key="TearOutButton" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="8,0,-6,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Content" Value="&#xE8A7;" />
      <Setter Property="ToolTip" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{StaticResource PanelBorder}" />
      <Setter Property="ResizeDirection" Value="Columns" />
      <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ToolTip" Value="Arrow keys resize" />
      <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Width" Value="9" />
          <Setter Property="Margin" Value="-2,0" />
          <Setter Property="Panel.ZIndex" Value="1" />
          <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowSplitter" TargetType="GridSplitter">
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{StaticResource PanelBorder}" />
      <Setter Property="ResizeDirection" Value="Rows" />
      <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ToolTip" Value="Arrow keys resize" />
      <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Height" Value="12" />
          <Setter Property="Margin" Value="0,2,0,-2" />
          <Setter Property="Panel.ZIndex" Value="1" />
          <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The analysis controls (analysis-runner.md, "The player"): every
         target at least 44 by 44 pixels, for head pointer and eye tracking
         use, and every one a single click. -->
    <Style x:Key="AnalysisButton" TargetType="Button">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <!-- The Analysis menu's items: 44 pixels high, in the system's menu
         colors so their text has the menu's own contrast. -->
    <Style x:Key="AnalysisMenuItem" TargetType="MenuItem">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
  </Window.Resources>

  <DockPanel>
  <!-- The menu bar, with two menus: Analysis (analysis-runner.md, "The
       player") and Android (android-implementation-plan.md). Each item
       opens with a single click; none has a submenu. -->
  <!-- The menu bar stands out from the window: a lighter bar, #2A2926,
       with an edge under it, and each menu drawn as a button with an edge,
       #75736F, 3.1 to 1 or more against both (owner, 2026-11-10: "make
       that top menu bar much more visible"). -->
  <Menu x:Name="MainMenu"
        DockPanel.Dock="Top"
        Background="#2A2926"
        BorderBrush="{StaticResource PanelBorder}"
        BorderThickness="0,0,0,1"
        Padding="4"
        AutomationProperties.Name="Menu bar">
    <MenuItem x:Name="AnalysisMenu"
              Header="_Analysis"
              MinHeight="44"
              Margin="0,0,6,0"
              Padding="14,0"
              VerticalContentAlignment="Center"
              Background="#2A2926"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1"
              FontWeight="SemiBold"
              Foreground="#CDCCCA"
              SubmenuOpened="AnalysisMenu_SubmenuOpened">
      <MenuItem x:Name="SummariseMenuItem"
                Style="{StaticResource AnalysisMenuItem}"
                Header="_Summarise this recording"
                Click="SummariseMenuItem_Click" />
      <MenuItem x:Name="VisionMenuItem"
                Style="{StaticResource AnalysisMenuItem}"
                Header="Add _vision to the summary"
                Click="VisionMenuItem_Click" />
      <MenuItem x:Name="CapabilitiesMenuItem"
                Style="{StaticResource AnalysisMenuItem}"
                Header="_Describe the participant's capabilities..."
                Click="CapabilitiesMenuItem_Click" />
      <MenuItem x:Name="ShowAnalysisMenuItem"
                Style="{StaticResource AnalysisMenuItem}"
                Header="Show the Analysis _tab"
                Click="ShowAnalysisMenuItem_Click" />
      <MenuItem x:Name="ModelProfilesMenuItem"
                Style="{StaticResource AnalysisMenuItem}"
                Header="_Model profiles..."
                Click="ModelProfilesMenuItem_Click" />
      <MenuItem x:Name="ModelSetupMenuItem"
                Style="{StaticResource AnalysisMenuItem}"
                Header="Set _up models..."
                Click="ModelSetupMenuItem_Click" />
      <!-- On by default; saved in the analysis settings file as
           "reportBrowserOnly" (report-fixes-2026-10-18.md, part 4). -->
      <MenuItem x:Name="BrowserOnlyMenuItem"
                Style="{StaticResource AnalysisMenuItem}"
                Header="Limit the report to the _browser while it is in front"
                IsCheckable="True"
                IsChecked="True"
                Click="BrowserOnlyMenuItem_Click" />
    </MenuItem>
    <MenuItem x:Name="AndroidMenu"
              Header="An_droid"
              MinHeight="44"
              Margin="0,0,6,0"
              Padding="14,0"
              VerticalContentAlignment="Center"
              Background="#2A2926"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1"
              FontWeight="SemiBold"
              Foreground="#CDCCCA">
      <MenuItem x:Name="AndroidSetupMenuItem"
                Style="{StaticResource AnalysisMenuItem}"
                Header="Set _up Android recording..."
                Click="AndroidSetupMenuItem_Click" />
    </MenuItem>
  </Menu>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidePanelColumn" Width="340" MinWidth="300" MaxWidth="440" />
      <ColumnDefinition x:Name="SidePanelSplitterColumn" Width="5" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="SidePanel"
            Grid.Column="0"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="0,0,1,0">
      <Grid Margin="18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
          <local:SelectableText FontSize="22"
                     FontWeight="SemiBold"
                     Text="Accessibility Recorder" />
          <local:SelectableText Margin="0,4,0,0"
                     Foreground="{StaticResource MutedText}"
                     TextWrapping="Wrap"
                     Text="Capture a session or open an existing recording." />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Button x:Name="OpenRecordingButton"
                    Margin="0,0,0,14"
                    HorizontalContentAlignment="Center"
                    Content="_Open recording..."
                    Click="OpenRecordingButton_Click" />

            <!-- What to record (android-implementation-plan.md, slice 1).
                 Choosing the Android device shows its checks panel in place
                 of the desktop's channels. Each choice is a 44 pixel high
                 target. -->
            <GroupBox Header="Recording target" Padding="10" Margin="0,0,0,12">
              <StackPanel>
                <RadioButton x:Name="DesktopTargetRadioButton"
                             GroupName="RecordingTarget"
                             IsChecked="True"
                             MinHeight="44"
                             VerticalContentAlignment="Center"
                             Foreground="#CDCCCA"
                             Content="This PC's desktop"
                             Checked="RecordingTarget_Checked" />
                <RadioButton x:Name="AndroidTargetRadioButton"
                             GroupName="RecordingTarget"
                             MinHeight="44"
                             VerticalContentAlignment="Center"
                             Foreground="#CDCCCA"
                             Content="Android de_vice"
                             AutomationProperties.HelpText="Checks the Android phone connected over USB."
                             Checked="RecordingTarget_Checked" />
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="CaptureChannelsGroupBox" Header="Capture channels" Padding="10" Margin="0,0,0,12">
              <StackPanel>
                <CheckBox x:Name="InputCheckBox"
                          IsChecked="True"
                          Content="_Keyboard and mouse input" />
                <CheckBox x:Name="AutomationCheckBox"
                          IsChecked="True"
                          Content="_UI Automation events" />
                <CheckBox x:Name="WindowCheckBox"
                          IsChecked="True"
                          Content="_Foreground window changes" />
                <CheckBox x:Name="FramesCheckBox"
                          IsChecked="True"
                          Content="Desk_top frames" />
                <CheckBox x:Name="MicrophoneCheckBox"
                          Content="_Microphone audio"
                          AutomationProperties.HelpText="Records speech and other sound from the default microphone." />
                <CheckBox x:Name="SystemAudioCheckBox"
                          Content="System _audio"
                          AutomationProperties.HelpText="Records audio rendered through the default Windows playback device, including screen reader speech." />
                <CheckBox x:Name="BrowserEvidenceCheckBox"
                          Content="_Instrumented Chromium evidence"
                          AutomationProperties.HelpText="Launches the recorder-owned instrumented Chromium build and records its browser evidence." />
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="BrowserCaptureGroupBox"
                      Header="Instrumented Chromium"
                      Padding="10"
                      Margin="0,0,0,12">
              <StackPanel>
                <local:SelectableText Margin="0,0,0,8"
                           Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Text="Proof of concept: launch the current instrumented build and record the browser evidence it emits." />
                <Label Target="{Binding ElementName=ChromiumPathTextBox}"
                       Content="Chromium _executable:" />
                <TextBox x:Name="ChromiumPathTextBox"
                         Margin="0,0,0,8"
                         AutomationProperties.Name="Instrumented Chromium executable" />
                <Button x:Name="BrowseChromiumButton"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Content="_Browse for Chromium..."
                        Click="BrowseChromiumButton_Click" />
                <Label Target="{Binding ElementName=BrowserProfileTextBox}"
                       Content="Browser _profile folder:" />
                <TextBox x:Name="BrowserProfileTextBox"
                         Margin="0,0,0,8"
                         AutomationProperties.Name="Browser profile folder"
                         AutomationProperties.HelpText="Leave empty for a new profile for each recording, removed after it. Choose a prepared profile folder, such as one for a test account, to record with it. Only the listed accessibility preferences are recorded from it, not its browsing data." />
                <local:SelectableText Margin="0,0,0,8"
                           Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Text="Empty for a new profile for each recording. A prepared folder is kept, and only its accessibility preferences are recorded." />
                <Button x:Name="BrowseProfileButton"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Content="Browse for p_rofile folder..."
                        Click="BrowseProfileButton_Click" />
                <Label Target="{Binding ElementName=BrowserStartUrlTextBox}"
                       Content="Starting _website:" />
                <TextBox x:Name="BrowserStartUrlTextBox"
                         Text="about:blank"
                         AutomationProperties.Name="Starting website address"
                         AutomationProperties.HelpText="Enter an absolute website address, or about:blank." />
                <CheckBox x:Name="FullWalkCheckBox"
                          Margin="0,8,0,0"
                          Content="C_heck change records against a full walk"
                          AutomationProperties.HelpText="Walks each page in full every so many updates, so the change records can be compared with it. Slows the page while it walks." />
                <Label Target="{Binding ElementName=FullWalkIntervalTextBox}"
                       Content="Wa_lk every N updates:" />
                <TextBox x:Name="FullWalkIntervalTextBox"
                         Text="100"
                         IsEnabled="{Binding IsChecked, ElementName=FullWalkCheckBox}"
                         AutomationProperties.Name="Full walk interval in updates"
                         AutomationProperties.HelpText="A whole number from 1. Each page is walked in full at every Nth mutation delivery and every Nth rendering update." />
                <Button x:Name="OpenFixedRecreationButton"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Content="Open recreation with _fixed content"
                        AutomationProperties.HelpText="Opens a fixed test page in the instrumented Chromium with DevTools and the evidence panel. The page is written in code and is not evidence from a recording."
                        Click="OpenFixedRecreationButton_Click" />
              </StackPanel>
            </GroupBox>

            <!-- The Android device's checks (android-implementation-plan.md,
                 slice 1), read again every 2 seconds while it is shown. -->
            <GroupBox x:Name="AndroidChecksGroupBox"
                      Header="Android device checks"
                      Padding="10"
                      Margin="0,0,0,12"
                      Visibility="Collapsed">
              <StackPanel>
                <local:SelectableText x:Name="AndroidChecksText"
                           TextWrapping="Wrap"
                           Text="Checking the phone." />
                <!-- Shown while the phone is connected and its companion
                     app is not ready (slice 2): installs the recorder's
                     copy, or turns the installed one on. -->
                <Button x:Name="CompanionButton"
                        Margin="0,12,0,0"
                        MinHeight="44"
                        MinWidth="44"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        Content="Install companion app"
                        AutomationProperties.HelpText="Installs the recorder's companion app on the phone over USB, or turns it on, and leaves the phone's other accessibility services, such as TalkBack, as they are."
                        Click="CompanionButton_Click" />
                <local:SelectableText x:Name="CompanionResultText"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <local:SelectableText Margin="0,8,0,0"
                           Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Text="A recording of the phone records the companion app's connection, the phone's clock, its display's rotation and size, and the phone's screen as a video stream and as a picture for each change, which the player shows and an MP4 export saves. It also records the phone's sound, shows its level while recording and plays it on this PC, and records this PC's microphone. When TalkBack is on, the companion app raises the phone's Accessibility volume to at least 80% as the recording starts and leaves it there. The player shows and plays the phone's sound as &quot;Phone sound&quot;, in the system sound's place, and an MP4 export saves it. It records every touch on the phone's screen and every hardware key, such as volume and power, with each finger's position in screen pixels. The player draws each finger on the phone's picture as a yellow circle, numbered when there is more than one, with its path, and shows the touches and keys as &quot;Touches&quot; and &quot;Phone keys&quot; in the mouse's and keyboard's places. It records every line TalkBack writes to the phone's log, and what TalkBack said, read from those lines, when TalkBack's log output level is Verbose. The player shows what TalkBack said as &quot;TalkBack said&quot; in the screen reader's place, with each utterance's text in a strip under the Screen reader lane, interrupted ones marked, and its words in the properties panel. It also records every accessibility event the phone sends to accessibility services, with the item each one came from, and snapshots of the phone's accessibility tree: every window's items as the recording starts and when a window changes, and a window's items again when its content changes. The player shows the events and the snapshots as &quot;Accessibility events&quot; in UI Automation's place, draws a yellow outline on the phone's picture around the item with accessibility focus, and shows the tree at the playhead in the Accessibility tree tab, with that item marked &quot;accessibility focus&quot;. It records the phone's accessibility settings, such as color inversion, magnification, font size and the services on, as the recording starts and stops and each time one changes, and the properties panel shows them at the playhead, in the Windows settings' place, with &quot;Phone settings&quot; as their filter. It reads the phone's display density as the recording starts and stops, and the version of each app it saw as the recording stops, and the Checks tab shows them. It saves a screenshot the companion app takes of the phone's screen as the recording starts and each time a window has had no change for half a second, for measuring colours without the video's compression. It records how the phone itself is held, upright, sideways or flat, from the companion app's own sensor, for the orientation check." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Playback event filters"
                      Padding="10"
                      Margin="0,0,0,12">
              <StackPanel>
                <UniformGrid Columns="2">
                  <CheckBox x:Name="FilterKeyboardCheckBox"
                            IsChecked="True"
                            Content="_Keyboard"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterMouseCheckBox"
                            IsChecked="True"
                            Content="_Mouse"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterAutomationCheckBox"
                            IsChecked="True"
                            Content="_UI Automation"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterWindowCheckBox"
                            IsChecked="True"
                            Content="_Window"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterPreferencesCheckBox"
                            IsChecked="True"
                            Content="Windows settings"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterMagnifierCheckBox"
                            IsChecked="True"
                            Content="Magnifier changes"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterBrowserSettingsCheckBox"
                            IsChecked="True"
                            Content="Browser settings"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterAssistiveTechnologyCheckBox"
                            IsChecked="True"
                            Content="Screen reader"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterFramesCheckBox"
                            IsChecked="True"
                            Content="_Frames"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterMicrophoneCheckBox"
                            IsChecked="True"
                            Content="M_icrophone"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterSystemAudioCheckBox"
                            IsChecked="True"
                            Content="System _audio"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterScreenReaderAudioCheckBox"
                            IsChecked="True"
                            Content="Screen reader sound"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterMarkersCheckBox"
                            IsChecked="True"
                            Content="Mar_kers"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterBrowserCheckBox"
                            IsChecked="True"
                            Content="_Browser"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterOtherCheckBox"
                            IsChecked="True"
                            Content="_Other"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                </UniformGrid>
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                  <Button Margin="0,0,8,0"
                          Content="Select _all"
                          Click="SelectAllFiltersButton_Click" />
                  <Button Content="_Clear all"
                          Click="ClearAllFiltersButton_Click" />
                </StackPanel>
                <local:SelectableText x:Name="FilterSummaryTextBlock"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource MutedText}"
                           Text="No recording loaded."
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Storage" Padding="10" Margin="0,0,0,12">
              <StackPanel>
                <TextBox x:Name="OutputRootTextBox"
                         Margin="0,0,0,8"
                         AutomationProperties.Name="Session output folder" />
                <Button x:Name="BrowseButton"
                        HorizontalAlignment="Left"
                        Content="_Browse..."
                        Click="BrowseButton_Click" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Session marker" Padding="10" Margin="0,0,0,12">
              <StackPanel>
                <Label Target="{Binding ElementName=MarkerNoteTextBox}"
                       Content="Optional marker _note:" />
                <TextBox x:Name="MarkerNoteTextBox"
                         Margin="0,0,0,8" />
                <Button x:Name="MarkerButton"
                        HorizontalAlignment="Left"
                        Content="Add mark_er"
                        IsEnabled="False"
                        Click="MarkerButton_Click" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Current session" Padding="10">
              <StackPanel>
                <local:SelectableText x:Name="StatusTextBlock"
                           FontWeight="SemiBold"
                           Text="Ready to record."
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <local:SelectableText x:Name="DurationTextBlock"
                           Margin="0,6,0,0"
                           Text="Duration: 00:00:00" />
                <local:SelectableText x:Name="EvidenceTextBlock"
                           Margin="0,4,0,0"
                           Text="Events: 0 accepted, 0 dropped" />
                <local:SelectableText Margin="0,8,0,2" Text="Collector status:" />
                <!-- One line per collector, as wrapping text like the lines above it
                     (owner, 2026-11-08: no separate block and no horizontal
                     scroll bar); it can be selected and copied
                     (player-layout.md, "Selecting and copying text"). -->
                <local:SelectableText x:Name="CollectorStatusText"
                           TextWrapping="Wrap" />
                <local:SelectableText Margin="0,8,0,2" Text="Session folder:" />
                <TextBox x:Name="SessionFolderTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Current session folder" />
                <Button x:Name="OpenFolderButton"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Content="_Open session folder"
                        IsEnabled="False"
                        Click="OpenFolderButton_Click" />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button x:Name="StartButton"
                  Grid.Column="0"
                  Margin="0,0,5,0"
                  Content="_Start recording"
                  Click="StartButton_Click" />
          <Button x:Name="StopButton"
                  Grid.Column="1"
                  Margin="5,0,0,0"
                  Content="S_top recording"
                  IsEnabled="False"
                  Click="StopButton_Click" />
        </Grid>
      </Grid>
    </Border>

    <GridSplitter x:Name="SidePanelSplitter"
                  Grid.Column="1"
                  Style="{StaticResource ColumnSplitter}"
                  AutomationProperties.Name="Resize recorder controls and playback" />

    <!-- The player: the video, then the region under it. While the details
         are shown, the splitter sets the region's height; otherwise the
         region takes the height of its controls. See
         docs/architecture/player-layout.md. -->
    <Grid x:Name="PlayerGrid" Grid.Column="2" Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="160" />
        <RowDefinition x:Name="LowerSplitterRow" Height="Auto" />
        <RowDefinition x:Name="LowerRegionRow" Height="Auto" />
      </Grid.RowDefinitions>

      <!-- The video and, to its right, the properties panel: the Magnifier
           readings of the frame shown and the Windows settings in effect.
           See docs/architecture/accessibility-preferences.md, "The
           properties panel". -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="240" />
          <ColumnDefinition x:Name="PropertiesSplitterColumn" Width="5" />
          <ColumnDefinition x:Name="PropertiesColumn" Width="480" MinWidth="220" MaxWidth="800" />
        </Grid.ColumnDefinitions>
      <Border Grid.Column="0"
              Background="Black"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1">
        <Grid>
          <Image x:Name="VideoImage"
                 Stretch="Uniform"
                 SnapsToDevicePixels="True"
                 SizeChanged="VideoImage_SizeChanged"
                 AutomationProperties.Name="Recorded desktop video frame" />
          <local:SelectableText x:Name="VideoPlaceholderTextBlock"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="#A09F9B"
                     FontSize="18"
                     Text="Open a recording to begin playback." />
        </Grid>
      </Border>

        <GridSplitter x:Name="PropertiesSplitter"
                      Grid.Column="1"
                      Style="{StaticResource ColumnSplitter}"
                      KeyboardIncrement="20"
                      DragCompleted="PropertiesSplitter_DragCompleted"
                      LostKeyboardFocus="PropertiesSplitter_LostKeyboardFocus"
                      AutomationProperties.Name="Resize video and properties" />

        <GroupBox x:Name="PropertiesRegion"
                  Grid.Column="2"
                  Padding="4"
                  Header="Properties">
          <DockPanel>
          <local:SelectableText DockPanel.Dock="Bottom"
                     Margin="2,6,2,0"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource MutedText}"
                     Text="The buttons at the end of a row step through that setting's changes. The count is the change in effect, of all its changes from the start. Keys: Ctrl+Left and Ctrl+Right step; Enter goes to the change that set the value." />
          <ListView x:Name="PropertiesListView"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    PreviewKeyDown="PropertiesListView_PreviewKeyDown"
                    MouseLeave="PropertiesListView_MouseLeave"
                    MouseDoubleClick="PropertiesListView_MouseDoubleClick"
                    AutomationProperties.Name="Properties at the frame shown"
                    AutomationProperties.HelpText="Each row reads setting, value, when it was set, and, for a setting that changed during the recording, which of its changes is in effect. Its previous and next change buttons, or Ctrl+Left and Ctrl+Right, move to the setting's previous and next change. Enter: the change that set the value.">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <!-- Top aligned: a row's height changes as its value does,
                     and the change buttons must stay under a still pointer. -->
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                <Setter Property="ToolTip" Value="{Binding Spoken}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Changed}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <local:SelectableText Margin="0,6,0,2"
                               FontWeight="SemiBold"
                               Text="{Binding Name, Mode=OneWay}" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Header="Setting" Width="120">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <local:SelectableText Text="{Binding Setting, Mode=OneWay}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Value" Width="110">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <local:SelectableText Text="{Binding Value, Mode=OneWay}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="When set" Width="80">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <local:SelectableText Text="{Binding WhenSetShown, Mode=OneWay}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <!-- Previous and next change buttons and the count, on a
                     row whose setting changed during the recording. The
                     buttons are 44 by 44 pixels for head pointer and eye
                     tracking use, act on their own row, and do not take
                     focus; their keyboard equivalents are Ctrl+Left and
                     Ctrl+Right on the row. A disabled button still shows its
                     tooltip. The count has a fixed width, so the buttons do
                     not move as it changes, and the buttons are at the top of
                     the row, so they do not move as its height changes. -->
                <GridViewColumn Header="Changes" Width="150">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal"
                                  VerticalAlignment="Top"
                                  Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibility}}">
                        <Button Style="{StaticResource PropertyChangeButton}"
                                Content="&#x25C0;"
                                IsEnabled="{Binding CanGoPrevious}"
                                Click="PropertyPreviousChange_Click"
                                ToolTip="{Binding PreviousName}"
                                AutomationProperties.Name="{Binding PreviousName}" />
                        <Button Style="{StaticResource PropertyChangeButton}"
                                Margin="4,0,0,0"
                                Content="&#x25B6;"
                                IsEnabled="{Binding CanGoNext}"
                                Click="PropertyNextChange_Click"
                                ToolTip="{Binding NextName}"
                                AutomationProperties.Name="{Binding NextName}" />
                        <local:SelectableText Margin="8,0,0,0"
                                   MinWidth="48"
                                   VerticalAlignment="Center"
                                   Text="{Binding CountShown, Mode=OneWay}"
                                   ToolTip="{Binding CountSpoken}"
                                   AutomationProperties.Name="{Binding CountSpoken}" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          </DockPanel>
        </GroupBox>
      </Grid>

      <GridSplitter x:Name="LowerSplitter"
                    Grid.Row="1"
                    Style="{StaticResource RowSplitter}"
                    Visibility="Collapsed"
                    DragCompleted="LowerSplitter_DragCompleted"
                    AutomationProperties.Name="Resize video and details" />

      <Grid x:Name="LowerRegion" Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

      <Grid x:Name="TransportPanel" Grid.Row="0" Margin="0,12,0,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ToggleButton x:Name="SettingsToggle"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        IsChecked="True"
                        Content="Settings"
                        Click="SettingsToggle_Click"
                        AutomationProperties.Name="Settings"
                        AutomationProperties.AcceleratorKey="Ctrl+Shift+S"
                        AutomationProperties.HelpText="Shows or hides the recorder settings beside the player." />
          <ToggleButton x:Name="DetailsToggle"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        IsChecked="True"
                        Content="Details"
                        Click="DetailsToggle_Click"
                        AutomationProperties.Name="Details"
                        AutomationProperties.AcceleratorKey="Ctrl+Shift+D"
                        AutomationProperties.HelpText="Shows or hides the browser navigation and selected event values under the timeline." />
          <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ToggleButton x:Name="PropertiesToggle"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        IsChecked="True"
                        Content="Properties"
                        Click="PropertiesToggle_Click"
                        AutomationProperties.Name="Properties"
                        AutomationProperties.AcceleratorKey="Ctrl+Shift+P"
                        AutomationProperties.HelpText="Shows or hides the Magnifier readings and Windows settings at the frame shown, beside the video." />
          <ToggleButton x:Name="FrameOnlyToggle"
                        Margin="0,0,16,0"
                        Padding="8,0"
                        IsChecked="False"
                        IsEnabled="False"
                        Content="Frame only"
                        Click="FrameOnlyToggle_Click"
                        AutomationProperties.Name="Frame only"
                        AutomationProperties.AcceleratorKey="F11"
                        AutomationProperties.HelpText="Shows only the video, the playback controls, and the timeline. Press F11 or Escape to return." />
          </StackPanel>
          <Button x:Name="PreviousFrameButton"
                  Grid.Column="3"
                  Margin="0,0,8,0"
                  Content="Previous _frame"
                  IsEnabled="False"
                  Click="PreviousFrameButton_Click" />
          <Button x:Name="PlayPauseButton"
                  Grid.Column="4"
                  Margin="0,0,8,0"
                  MinWidth="90"
                  Content="_Play"
                  IsEnabled="False"
                  Click="PlayPauseButton_Click" />
          <Button x:Name="NextFrameButton"
                  Grid.Column="5"
                  Margin="0,0,12,0"
                  Content="_Next frame"
                  IsEnabled="False"
                  Click="NextFrameButton_Click" />
          <Slider x:Name="PlaybackSlider"
                  Grid.Column="6"
                  VerticalAlignment="Center"
                  Minimum="0"
                  Maximum="1"
                  IsEnabled="False"
                  IsMoveToPointEnabled="True"
                  ValueChanged="PlaybackSlider_ValueChanged"
                  AutomationProperties.Name="Recording position" />
          <local:SelectableText x:Name="PlaybackTimeTextBlock"
                     Grid.Column="7"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     FontFamily="Consolas"
                     Text="00:00:00.000 / 00:00:00.000"
                     AutomationProperties.LiveSetting="Off" />
          <Button x:Name="InspectPageButton"
                  Grid.Column="8"
                  Margin="12,0,0,0"
                  Content="Inspect pa_ge at this frame"
                  IsEnabled="False"
                  AutomationProperties.HelpText="Recreates a recorded page as it was at the frame shown, in the instrumented Chromium with DevTools and the evidence panel. No page script runs."
                  Click="InspectPageButton_Click" />
          <ToggleButton x:Name="WholeScreenToggle"
                        Grid.Column="9"
                        Margin="12,0,0,0"
                        Padding="8,0"
                        IsChecked="False"
                        IsEnabled="False"
                        Content="Whole screen"
                        Click="WholeScreenToggle_Click"
                        AutomationProperties.Name="Whole screen"
                        AutomationProperties.HelpText="No recording is open." />
        </Grid>

        <Grid x:Name="VolumePanel" Grid.Row="1" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0"
                 Padding="0,0,8,0"
                 VerticalContentAlignment="Center"
                 Target="{Binding ElementName=MicrophoneVolumeSlider}"
                 Content="_Microphone:" />
          <Slider x:Name="MicrophoneVolumeSlider"
                  Grid.Column="1"
                  Minimum="-36"
                  Maximum="0"
                  Value="0"
                  TickFrequency="3"
                  IsSnapToTickEnabled="True"
                  ValueChanged="AudioVolumeSlider_ValueChanged"
                  AutomationProperties.Name="Microphone playback gain" />
          <local:SelectableText x:Name="MicrophoneVolumeTextBlock"
                     Grid.Column="2"
                     Margin="8,0,0,0"
                     MinWidth="52"
                     VerticalAlignment="Center"
                     Text="0 dB" />
          <!-- Labelled "Phone sound" for a recording of a phone, whose
               sound takes the system sound's place (Android slice 4b). -->
          <Label x:Name="SystemAudioVolumeLabel"
                 Grid.Column="4"
                 Padding="0,0,8,0"
                 VerticalContentAlignment="Center"
                 Target="{Binding ElementName=SystemAudioVolumeSlider}"
                 Content="S_ystem audio:" />
          <Slider x:Name="SystemAudioVolumeSlider"
                  Grid.Column="5"
                  Minimum="-36"
                  Maximum="0"
                  Value="0"
                  TickFrequency="3"
                  IsSnapToTickEnabled="True"
                  ValueChanged="AudioVolumeSlider_ValueChanged"
                  AutomationProperties.Name="System audio playback gain" />
          <local:SelectableText x:Name="SystemAudioVolumeTextBlock"
                     Grid.Column="6"
                     Margin="8,0,0,0"
                     MinWidth="52"
                     VerticalAlignment="Center"
                     Text="0 dB" />
          <!-- Recorded on its own only when NVDA was running and Windows
               could separate its sound; see docs/architecture/mp4-export.md. -->
          <Label Grid.Column="8"
                 Padding="0,0,8,0"
                 VerticalContentAlignment="Center"
                 Target="{Binding ElementName=ScreenReaderVolumeSlider}"
                 Content="Screen reader:" />
          <Slider x:Name="ScreenReaderVolumeSlider"
                  Grid.Column="9"
                  Minimum="-36"
                  Maximum="0"
                  Value="0"
                  TickFrequency="3"
                  IsSnapToTickEnabled="True"
                  ValueChanged="AudioVolumeSlider_ValueChanged"
                  AutomationProperties.Name="Screen reader playback gain" />
          <local:SelectableText x:Name="ScreenReaderVolumeTextBlock"
                     Grid.Column="10"
                     Margin="8,0,0,0"
                     MinWidth="52"
                     VerticalAlignment="Center"
                     Text="0 dB" />
          <Button x:Name="SaveMp4Button"
                  Grid.Column="12"
                  Margin="12,0,0,0"
                  Content="Save as MP_4..."
                  IsEnabled="False"
                  Click="SaveMp4Button_Click"
                  AutomationProperties.HelpText="Saves the whole recording as an MP4 video with the sounds you choose." />
        </Grid>
      </Grid>

      <Grid x:Name="TimelinePanel" Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="128" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                AutomationProperties.Name="Session event timeline">
          <local:SessionTimelineControl x:Name="TimelineControl"
                                        SelectedEventChanged="TimelineControl_SelectedEventChanged"
                                        LookupFailed="TimelineControl_LookupFailed"
                                        PositionRequested="TimelineControl_PositionRequested"
                                        AutomationProperties.Name="Selectable session event timeline"
                                        AutomationProperties.HelpText="Click an event, or use Left, Right, Home, and End to move within a lane and Up and Down to move between lanes while focused, to inspect captured values. Click the NVDA mode strip, under the Screen reader lane, to move the playhead there. Click the NVDA window strip under it, or move into it with Up or Down, to select an NVDA window's events, then use Left, Right, Home, and End to step through them. In a recording of a phone, click the TalkBack said strip, under the Screen reader lane, to select an utterance; the properties panel gives its text and the words reached. The screen visits strip under it shows each visit's screen; click it to move the playhead there, and the Checks tab lists the visits." />
        </Border>
        <Grid Grid.Row="1" Margin="0,8,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0"
                 Padding="0,0,8,0"
                 VerticalContentAlignment="Center"
                 Target="{Binding ElementName=TimelineZoomSlider}"
                 Content="Timeline _zoom:" />
          <Slider x:Name="TimelineZoomSlider"
                  Grid.Column="1"
                  Minimum="0"
                  Maximum="12"
                  Value="0"
                  TickFrequency="1"
                  IsSnapToTickEnabled="True"
                  IsEnabled="False"
                  ValueChanged="TimelineZoomSlider_ValueChanged"
                  AutomationProperties.Name="Timeline zoom" />
          <local:SelectableText x:Name="TimelineZoomTextBlock"
                     Grid.Column="2"
                     Margin="8,0,12,0"
                     MinWidth="32"
                     VerticalAlignment="Center"
                     Text="1×" />
          <Button x:Name="FitTimelineButton"
                  Grid.Column="3"
                  Content="_Fit"
                  IsEnabled="False"
                  Click="FitTimelineButton_Click" />
        </Grid>
        <ScrollBar x:Name="TimelinePanScrollBar"
                   Grid.Row="2"
                   Orientation="Horizontal"
                   Minimum="0"
                   Maximum="0"
                   Value="0"
                   IsEnabled="False"
                   ValueChanged="TimelinePanScrollBar_ValueChanged"
                   AutomationProperties.Name="Timeline visible range start" />
      </Grid>

      <Grid x:Name="DetailsRegion" Grid.Row="2" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="300" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="3*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <!-- Two tabs: the browser navigations, and the reading position's
             steps (screen-reader-activity.md, "4b, the list of steps").
             The tabs and each step are at least 44 pixels high, for a
             head pointer or eye tracking. -->
        <!-- The tabs take the player's dark panels and light text, as the
             group boxes do: #CDCCCA on #1C1B19 is 10.7 to 1, and on an
             unselected tab's #201F1D 10.3 to 1. The selected tab has a bar
             of #B79CE6 along its top, 7.3 to 1 against the panel, and bold
             text, so it is not shown by colour alone. Each tab's edge is
             #75736F, 3.5 to 1 or more against the panels; a focused tab's
             edge takes the system highlight colour, at the same width, so
             nothing moves. Windows' default white
             tab panel left the light text at a low contrast (owner's
             screenshots, 2026-10-12). -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1">
          <local:SelectableText x:Name="AllTabsTornOutTextBlock"
                     Margin="12"
                     TextWrapping="Wrap"
                     Visibility="Collapsed"
                     Text="Each of these tabs is in its own window. Close a window to put its tab back here." />
        </Border>
        <TabControl x:Name="DetailsTabControl"
                    Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    Foreground="#CDCCCA"
                    Padding="0"
                    AutomationProperties.Name="Browser navigations and reading position steps">
          <TabControl.Resources>
            <Style TargetType="TabItem">
              <Setter Property="MinHeight" Value="44" />
              <Setter Property="MinWidth" Value="44" />
              <Setter Property="Padding" Value="12,4" />
              <Setter Property="Foreground" Value="#CDCCCA" />
              <Setter Property="Background" Value="#201F1D" />
              <Setter Property="BorderBrush" Value="#75736F" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            Margin="0,0,2,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2,2,2,0">
                      <Grid>
                        <Border x:Name="SelectedBar"
                                Height="3"
                                VerticalAlignment="Top"
                                Background="Transparent" />
                        <ContentPresenter ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="TabBorder" Property="Background" Value="#2A2926" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelBackground}" />
                        <Setter TargetName="SelectedBar" Property="Background" Value="#B79CE6" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TabControl.Resources>
          <TabItem x:Name="BrowserNavigationTab"
                   AutomationProperties.Name="Browser navigation correlation"
                   PreviewMouseLeftButtonDown="DetailsTab_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="DetailsTab_PreviewMouseMove"
                   PreviewMouseLeftButtonUp="DetailsTab_PreviewMouseLeftButtonUp"
                   LostMouseCapture="DetailsTab_LostMouseCapture">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Browser navigation correlation" />
                <Button Style="{StaticResource TearOutButton}"
                        Tag="{Binding ElementName=BrowserNavigationTab}"
                        Click="TearOutButton_Click"
                        AutomationProperties.Name="Open Browser navigation correlation in its own window" />
              </StackPanel>
            </TabItem.Header>
          <Grid Margin="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel x:Name="BrowserNavigationFilterPanel"
                       Grid.Row="0"
                       Margin="0,0,0,6"
                       AutomationProperties.Name="Navigation kinds to list">
              <local:SelectableText Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Text="Show:" />
              <CheckBox x:Name="ShowPageNavigationsCheckBox"
                        Margin="0,0,12,0"
                        IsChecked="True"
                        Content="Pages"
                        Click="BrowserNavigationFilter_Click" />
              <CheckBox x:Name="ShowIframeNavigationsCheckBox"
                        Margin="0,0,12,0"
                        IsChecked="False"
                        Content="Iframes"
                        Click="BrowserNavigationFilter_Click" />
              <CheckBox x:Name="ShowBrowserUiNavigationsCheckBox"
                        Margin="0,0,12,0"
                        IsChecked="False"
                        Content="Browser UI"
                        Click="BrowserNavigationFilter_Click" />
              <CheckBox x:Name="ShowOtherFrameNavigationsCheckBox"
                        IsChecked="False"
                        Content="Other frames"
                        Click="BrowserNavigationFilter_Click" />
            </WrapPanel>
            <ListBox x:Name="BrowserNavigationListBox"
                     Grid.Row="1"
                     MinHeight="70"
                     DisplayMemberPath="Label"
                     SelectionChanged="BrowserNavigationListBox_SelectionChanged"
                     AutomationProperties.Name="Recorded browser navigations"
                     AutomationProperties.HelpText="Select a navigation to seek to it and inspect its correlated browser evidence." />
            <TextBox x:Name="BrowserCorrelationTextBox"
                     Grid.Row="2"
                     Margin="0,6,0,0"
                     MinHeight="70"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Browser navigation correlation summary"
                     Text="Open a recording with browser evidence to inspect navigation correlation." />
          </Grid>
          </TabItem>
          <TabItem x:Name="ReadingStepsTab"
                   AutomationProperties.Name="Reading position steps"
                   PreviewMouseLeftButtonDown="DetailsTab_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="DetailsTab_PreviewMouseMove"
                   PreviewMouseLeftButtonUp="DetailsTab_PreviewMouseLeftButtonUp"
                   LostMouseCapture="DetailsTab_LostMouseCapture">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Reading position steps" />
                <Button Style="{StaticResource TearOutButton}"
                        Tag="{Binding ElementName=ReadingStepsTab}"
                        Click="TearOutButton_Click"
                        AutomationProperties.Name="Open Reading position steps in its own window" />
              </StackPanel>
            </TabItem.Header>
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                <Button x:Name="ShowCurrentStepButton"
                        DockPanel.Dock="Left"
                        MinHeight="44"
                        MinWidth="44"
                        Padding="12,0"
                        Content="Show current step"
                        Click="ShowCurrentStepButton_Click"
                        AutomationProperties.HelpText="Scrolls the list to the step at the playhead. The list does not scroll by itself." />
                <local:SelectableText x:Name="ReadingStepsStatusTextBlock"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Open a recording with accessibility requests to list the reading position's steps." />
              </DockPanel>
              <ListBox x:Name="ReadingStepsListBox"
                       Grid.Row="1"
                       MinHeight="70"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.ScrollUnit="Pixel"
                       Grid.IsSharedSizeScope="True"
                       AutomationProperties.Name="Reading position steps"
                       AutomationProperties.HelpText="Click a step, or press Enter or Space on it, to move the playhead to it and show its basis in Selected event values.">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,6" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                    <EventSetter Event="MouseLeftButtonUp" Handler="ReadingStep_MouseLeftButtonUp" />
                    <EventSetter Event="KeyDown" Handler="ReadingStep_KeyDown" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="BorderBrush" Value="#6A4C93" />
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="StepTime" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="StepState" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,10,0">
                        <local:SelectableText Text="{Binding Time, Mode=OneWay}" />
                        <local:SelectableText Text="at the playhead">
                          <local:SelectableText.Style>
                            <Style TargetType="local:SelectableText">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </local:SelectableText.Style>
                        </local:SelectableText>
                      </StackPanel>
                      <local:SelectableText Grid.Column="1" Margin="0,0,10,0" Text="{Binding State, Mode=OneWay}" />
                      <local:SelectableText Grid.Column="2" Margin="0,0,10,0" Text="{Binding Cause, Mode=OneWay}" TextWrapping="Wrap" />
                      <local:SelectableText Grid.Column="3" Text="{Binding Value, Mode=OneWay}" TextWrapping="Wrap" />
                      <!-- What NVDA had to announce at the step
                           (screen-reader-activity.md, "What NVDA had to
                           announce"), on a second line. -->
                      <local:SelectableText Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Margin="0,4,0,0"
                                 Text="{Binding Announcement, Mode=OneWay}"
                                 TextWrapping="Wrap">
                        <local:SelectableText.Style>
                          <Style TargetType="local:SelectableText">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Announcement}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </local:SelectableText.Style>
                      </local:SelectableText>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <!-- What NVDA had to announce at each reading position step
               (screen-reader-activity.md, "What NVDA had to announce"): as
               the list of steps, marked at the playhead but never scrolled
               by itself; Show current step scrolls to it. -->
          <TabItem x:Name="AnnouncementsTab"
                   AutomationProperties.Name="NVDA had to announce"
                   PreviewMouseLeftButtonDown="DetailsTab_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="DetailsTab_PreviewMouseMove"
                   PreviewMouseLeftButtonUp="DetailsTab_PreviewMouseLeftButtonUp"
                   LostMouseCapture="DetailsTab_LostMouseCapture">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="NVDA had to announce" />
                <Button Style="{StaticResource TearOutButton}"
                        Tag="{Binding ElementName=AnnouncementsTab}"
                        Click="TearOutButton_Click"
                        AutomationProperties.Name="Open NVDA had to announce in its own window" />
              </StackPanel>
            </TabItem.Header>
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                <Button x:Name="ShowCurrentAnnouncementButton"
                        DockPanel.Dock="Left"
                        MinHeight="44"
                        MinWidth="44"
                        Padding="12,0"
                        Content="Show current step"
                        Click="ShowCurrentAnnouncementButton_Click"
                        AutomationProperties.HelpText="Scrolls the list to the step at the playhead. The list does not scroll by itself." />
                <local:SelectableText x:Name="AnnouncementsStatusTextBlock"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Open a recording with accessibility requests to list what NVDA had to announce." />
              </DockPanel>
              <ListBox x:Name="AnnouncementsListBox"
                       Grid.Row="1"
                       MinHeight="70"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.ScrollUnit="Pixel"
                       Grid.IsSharedSizeScope="True"
                       AutomationProperties.Name="NVDA had to announce"
                       AutomationProperties.HelpText="Click a step, or press Enter or Space on it, to move the playhead to it and show the basis of what NVDA had to announce in Selected event values.">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,6" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                    <EventSetter Event="MouseLeftButtonUp" Handler="Announcement_MouseLeftButtonUp" />
                    <EventSetter Event="KeyDown" Handler="Announcement_KeyDown" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="BorderBrush" Value="#6A4C93" />
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AnnouncementTime" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AnnouncementState" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <local:SelectableText Text="{Binding Time, Mode=OneWay}" />
                        <local:SelectableText Text="at the playhead">
                          <local:SelectableText.Style>
                            <Style TargetType="local:SelectableText">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </local:SelectableText.Style>
                        </local:SelectableText>
                      </StackPanel>
                      <local:SelectableText Grid.Column="1" Margin="0,0,10,0" Text="{Binding State, Mode=OneWay}" />
                      <local:SelectableText Grid.Column="2" Margin="0,0,10,0" Text="{Binding Cause, Mode=OneWay}" TextWrapping="Wrap" />
                      <local:SelectableText Grid.Column="3" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <TabItem x:Name="AccessibilityTreeTab"
                   AutomationProperties.Name="Accessibility tree"
                   PreviewMouseLeftButtonDown="DetailsTab_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="DetailsTab_PreviewMouseMove"
                   PreviewMouseLeftButtonUp="DetailsTab_PreviewMouseLeftButtonUp"
                   LostMouseCapture="DetailsTab_LostMouseCapture">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Accessibility tree" />
                <Button Style="{StaticResource TearOutButton}"
                        Tag="{Binding ElementName=AccessibilityTreeTab}"
                        Click="TearOutButton_Click"
                        AutomationProperties.Name="Open Accessibility tree in its own window" />
              </StackPanel>
            </TabItem.Header>
            <!-- The page's accessibility tree at the playhead
                 (screen-reader-activity.md, "4c, the tree view"): read only,
                 each row at least 44 pixels high with a 44 by 44 pixel
                 expand button. It never scrolls, expands, or collapses by
                 itself; the two buttons do. -->
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <Button x:Name="ShowReadingPositionButton"
                        MinHeight="44"
                        MinWidth="44"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Content="Show reading position"
                        Click="ShowReadingPositionButton_Click"
                        AutomationProperties.HelpText="Expands the tree down to the reading position at the playhead, and scrolls to it." />
                <Button x:Name="ShowUnderPointerButton"
                        MinHeight="44"
                        MinWidth="44"
                        Padding="12,0"
                        Content="Show under the pointer"
                        Click="ShowUnderPointerButton_Click"
                        AutomationProperties.HelpText="Expands the tree down to the object under the pointer at the playhead, and scrolls to it." />
              </WrapPanel>
              <local:SelectableText x:Name="AccessibilityTreeStatusTextBlock"
                         Grid.Row="1"
                         Margin="0,0,0,6"
                         TextWrapping="Wrap"
                         Text="Open a recording with accessibility checkpoints to see the page's tree." />
              <TreeView x:Name="AccessibilityTreeView"
                        Grid.Row="2"
                        MinHeight="70"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        AutomationProperties.Name="Accessibility tree at the playhead"
                        AutomationProperties.HelpText="Click an object, or press Enter on it, to show its recorded version in Selected event values. The playhead does not move.">
                <TreeView.ItemContainerStyle>
                  <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <EventSetter Event="MouseLeftButtonUp" Handler="TreeRow_MouseLeftButtonUp" />
                    <EventSetter Event="KeyDown" Handler="TreeRow_KeyDown" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                          <StackPanel>
                            <Border x:Name="RowBorder"
                                    MinHeight="44"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="3,0,0,0">
                              <!-- The selected row's border: its background
                                   is 1.29:1 against the tree's white, so a
                                   border of 9.4:1 on it and 12.2:1 on white
                                   shows which row is selected (owner,
                                   2026-11-12: "it fails non-text contrast of
                                   3:1"). -->
                              <Border x:Name="SelectionBorder"
                                      BorderBrush="Transparent"
                                      BorderThickness="2">
                              <DockPanel>
                                <ToggleButton x:Name="Expander"
                                              DockPanel.Dock="Left"
                                              Width="44"
                                              Height="44"
                                              Focusable="False"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="12"
                                              Content="&#xE76C;"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              AutomationProperties.Name="{Binding ExpandName}" />
                                <ContentPresenter ContentSource="Header"
                                                  Margin="6,4"
                                                  VerticalAlignment="Center" />
                              </DockPanel>
                              </Border>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="22,0,0,0" />
                          </StackPanel>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                              <Setter TargetName="Expander" Property="Content" Value="&#xE70D;" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                              <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="RowBorder" Property="Background" Value="#E6E0F0" />
                              <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#3D2D5C" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsReading}" Value="True">
                              <Setter TargetName="RowBorder" Property="BorderBrush" Value="#6A4C93" />
                            </DataTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                  <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel>
                      <local:SelectableText Text="{Binding Label, Mode=OneWay}" TextWrapping="Wrap" />
                      <local:SelectableText Text="{Binding Detail, Mode=OneWay}" TextWrapping="Wrap" Foreground="#4A4945" />
                      <local:SelectableText Text="{Binding Markers, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold">
                        <local:SelectableText.Style>
                          <Style TargetType="local:SelectableText">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Markers}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </local:SelectableText.Style>
                      </local:SelectableText>
                    </StackPanel>
                  </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </Grid>
          </TabItem>
          <!-- A phone recording's apps, screens, visits and states
               (android-checks.md, step 1), grouped by app then screen, with
               how each screen was named. A visit or state moves the
               playhead to its start. The visit at the playhead is marked,
               but the list never scrolls by itself; Show current visit
               scrolls to it. Text wraps; there is no horizontal scrollbar. -->
          <TabItem x:Name="ChecksTab"
                   AutomationProperties.Name="Checks"
                   PreviewMouseLeftButtonDown="DetailsTab_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="DetailsTab_PreviewMouseMove"
                   PreviewMouseLeftButtonUp="DetailsTab_PreviewMouseLeftButtonUp"
                   LostMouseCapture="DetailsTab_LostMouseCapture">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Checks" />
                <Button Style="{StaticResource TearOutButton}"
                        Tag="{Binding ElementName=ChecksTab}"
                        Click="TearOutButton_Click"
                        AutomationProperties.Name="Open Checks in its own window" />
              </StackPanel>
            </TabItem.Header>
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <Button x:Name="ShowCurrentVisitButton"
                        MinHeight="44"
                        MinWidth="44"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Content="Show current visit"
                        Click="ShowCurrentVisitButton_Click"
                        AutomationProperties.HelpText="Scrolls the list to the visit at the playhead. The list does not scroll by itself." />
                <Button x:Name="PreviousFindingTimeButton"
                        MinHeight="44"
                        MinWidth="44"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Content="Previous time"
                        IsEnabled="False"
                        Click="PreviousFindingTimeButton_Click"
                        AutomationProperties.HelpText="Moves the playhead to the previous time the chosen finding was seen." />
                <Button x:Name="NextFindingTimeButton"
                        MinHeight="44"
                        MinWidth="44"
                        Padding="12,0"
                        Content="Next time"
                        IsEnabled="False"
                        Click="NextFindingTimeButton_Click"
                        AutomationProperties.HelpText="Moves the playhead to the next time the chosen finding was seen." />
                <!-- The audit level, AA or AAA, which guides the checks and
                     their reporting (owner, 2026-11-12), kept between runs;
                     changing it runs the tree's checks again and works the
                     text contrast findings out again from the same
                     measurement. -->
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0">
                  <TextBlock VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Text="Audit level:" />
                  <RadioButton x:Name="AuditAaRadioButton"
                               GroupName="AuditLevel"
                               MinHeight="44"
                               Margin="0,0,12,0"
                               VerticalContentAlignment="Center"
                               Foreground="#CDCCCA"
                               Content="AA"
                               AutomationProperties.Name="Audit level: AA"
                               AutomationProperties.HelpText="Checks to WCAG 2.2 level AA: text contrast to 1.4.3 and target size to 2.5.8."
                               Checked="AuditLevelRadioButton_Checked" />
                  <RadioButton x:Name="AuditAaaRadioButton"
                               GroupName="AuditLevel"
                               MinHeight="44"
                               VerticalContentAlignment="Center"
                               Foreground="#CDCCCA"
                               Content="AAA"
                               AutomationProperties.Name="Audit level: AAA"
                               AutomationProperties.HelpText="Checks to level AAA as well: text contrast to 1.4.6 in place of 1.4.3, and target size to 2.5.5, 44 by 44 dp."
                               Checked="AuditLevelRadioButton_Checked" />
                </StackPanel>
                <!-- How long the phone must be held turned before a screen
                     that did not turn with it is a finding (WCAG 1.3.4,
                     android-checks.md step 15, owner 2026-11-13: a
                     setting); kept between runs, and changing it runs the
                     tree's checks again. -->
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0">
                  <Label x:Name="OrientationHoldLabel"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"
                         Padding="0"
                         Foreground="#CDCCCA"
                         Target="{Binding ElementName=OrientationHoldComboBox}"
                         Content="Phone turned for:" />
                  <ComboBox x:Name="OrientationHoldComboBox"
                            MinWidth="120"
                            MinHeight="44"
                            VerticalContentAlignment="Center"
                            DisplayMemberPath="Text"
                            SelectedValuePath="Seconds"
                            AutomationProperties.Name="Phone turned for"
                            AutomationProperties.HelpText="How long the phone must be held turned, with Auto-rotate on, before a screen that did not turn with it is an orientation finding (WCAG 1.3.4)."
                            SelectionChanged="OrientationHoldComboBox_SelectionChanged" />
                </StackPanel>
              </WrapPanel>
              <local:SelectableText x:Name="ChecksStatusTextBlock"
                         Grid.Row="1"
                         Margin="0,0,0,6"
                         TextWrapping="Wrap"
                         Text="Open a recording of a phone to list its apps, screens and visits." />
              <ListBox x:Name="PhoneScreensListBox"
                       Grid.Row="2"
                       MinHeight="70"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.ScrollUnit="Pixel"
                       AutomationProperties.Name="Apps, screens, visits and findings"
                       AutomationProperties.HelpText="Click a row, or press Enter or Space on it, to move the playhead to the start of its visit or state; a screen's or an app's row moves it to the first visit. A finding's row moves it to the first time the finding was seen, selects its item in the Accessibility tree tab and outlines it on the phone's picture; Previous time and Next time step through the other times.">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,6" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                    <EventSetter Event="MouseLeftButtonUp" Handler="PhoneScreenRow_MouseLeftButtonUp" />
                    <EventSetter Event="KeyDown" Handler="PhoneScreenRow_KeyDown" />
                    <!-- The selected row as the tree's: #E6E0F0 with a
                         border of #3D2D5C, 9.4:1 on it and 12.2:1 on the
                         list's white, with focus or without. Windows'
                         own was #F6F6F6 without focus, 1.08:1 (owner,
                         2026-11-12, asked for the tree's border here). -->
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="RowBorder"
                                  Background="Transparent"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  SnapsToDevicePixels="True">
                            <Border x:Name="SelectionBorder"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    Padding="{TemplateBinding Padding}">
                              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="RowBorder" Property="Background" Value="#F3F0F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="RowBorder" Property="Background" Value="#E6E0F0" />
                              <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#3D2D5C" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsHeading}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="BorderBrush" Value="#6A4C93" />
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <local:SelectableText Margin="{Binding Indent}"
                               Text="{Binding Text, Mode=OneWay}"
                               TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <!-- The session's analysis tasks (analysis-runner.md, "The
               player"): the worker's line, queuing a summary with the
               profile to use, and each task with its buttons. -->
          <TabItem x:Name="AnalysisTab"
                   AutomationProperties.Name="Analysis"
                   PreviewMouseLeftButtonDown="DetailsTab_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="DetailsTab_PreviewMouseMove"
                   PreviewMouseLeftButtonUp="DetailsTab_PreviewMouseLeftButtonUp"
                   LostMouseCapture="DetailsTab_LostMouseCapture">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AnalysisTabHeaderText" VerticalAlignment="Center" Text="Analysis" />
                <Button Style="{StaticResource TearOutButton}"
                        Tag="{Binding ElementName=AnalysisTab}"
                        Click="TearOutButton_Click"
                        AutomationProperties.Name="Open Analysis in its own window" />
              </StackPanel>
            </TabItem.Header>
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <local:SelectableText x:Name="WorkerStatusTextBlock"
                         Grid.Row="0"
                         Margin="0,0,0,8"
                         TextWrapping="Wrap"
                         Text="The analysis worker is stopped."
                         AutomationProperties.Name="Analysis worker" />
              <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <Label Target="{Binding ElementName=ProfileComboBox}"
                       VerticalAlignment="Center"
                       Content="_Profile:" />
                <ComboBox x:Name="ProfileComboBox"
                          MinWidth="200"
                          MinHeight="44"
                          Margin="0,0,8,0"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="Profile to use" />
                <Button x:Name="QueueSummaryButton"
                        Style="{StaticResource AnalysisButton}"
                        Content="_Queue summary"
                        Click="QueueSummaryButton_Click" />
                <Button x:Name="RefreshAnalysisButton"
                        Style="{StaticResource AnalysisButton}"
                        Content="_Read the queue again"
                        Click="RefreshAnalysisButton_Click" />
              </WrapPanel>
              <ScrollViewer Grid.Row="2"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="AnalysisTasksPanel"
                            AutomationProperties.Name="Analysis tasks" />
              </ScrollViewer>
            </Grid>
          </TabItem>
        </TabControl>
        <!-- Drawn as the other splitters are, so it can be seen: it was
             transparent (docs/architecture/player-contrast.md). -->
        <GridSplitter Grid.Column="1"
                      Style="{StaticResource ColumnSplitter}"
                      AutomationProperties.Name="Resize browser correlation and event values" />
        <GroupBox Grid.Column="2"
                  Padding="8"
                  Header="Selected event values">
          <TextBox x:Name="EventDetailsTextBox"
                   MinHeight="70"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas"
                   AutomationProperties.Name="Selected event values"
                   Text="Select an event in the timeline to inspect its complete recorded values." />
        </GroupBox>
      </Grid>

      <Grid x:Name="StatusPanel" Grid.Row="3" Margin="0,8,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="BusyPanel"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
          <ProgressBar x:Name="BusyProgressBar"
                       Width="72"
                       Height="12"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Working"
                       AutomationProperties.HelpText="The recorder is busy. Please wait." />
          <local:SelectableText x:Name="BusyTextBlock"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold" />
        </StackPanel>
        <local:SelectableText x:Name="PlaybackStatusTextBlock"
                   Grid.Column="1"
                   Foreground="{StaticResource MutedText}"
                   Text="No recording loaded."
                   AutomationProperties.LiveSetting="Polite" />
        <local:SelectableText x:Name="TimelineLegendTextBlock"
                   Grid.Column="2"
                   Foreground="{StaticResource MutedText}"
                   Text="Keyboard | Mouse | UIA | Window | Frames | Mic | System audio" />
        <!-- The latest analysis task to finish or fail, until the next. -->
        <local:SelectableText x:Name="AnalysisStatusTextBlock"
                   Grid.Row="1"
                   Grid.ColumnSpan="3"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   AutomationProperties.Name="Analysis status" />
      </Grid>
      </Grid>
    </Grid>
  </Grid>
  </DockPanel>
</Window>
