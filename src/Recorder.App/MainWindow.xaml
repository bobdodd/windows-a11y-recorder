<Window x:Class="Recorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Recorder.App"
        Title="Windows Accessibility Recorder"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#171614"
        Foreground="#CDCCCA">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBackground" Color="#1C1B19" />
    <SolidColorBrush x:Key="PanelBorder" Color="#393836" />
    <SolidColorBrush x:Key="MutedText" Color="#A09F9B" />
    <Style TargetType="GroupBox">
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="Foreground" Value="#CDCCCA" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#CDCCCA" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="#CDCCCA" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#CDCCCA" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <!-- The splitters show keyboard focus: drawn in the highlight color,
         2 pixels wider on each side over their neighbours, with a tip
         naming the keys (docs/architecture/accessibility-preferences.md,
         "Visible focus and the Enter key"). The size and margin give the
         same layout size focused or not, so nothing moves. -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <!-- A previous or next change button of a properties row: a 44 by 44
         pixel target, the WCAG 2.5.5 size, for head pointer and eye
         tracking use. It does not take focus, so clicking it leaves the
         keyboard focus where it was. -->
    <Style x:Key="PropertyChangeButton" TargetType="Button">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="#393836" />
      <Setter Property="ResizeDirection" Value="Columns" />
      <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ToolTip" Value="Arrow keys resize" />
      <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Width" Value="9" />
          <Setter Property="Margin" Value="-2,0" />
          <Setter Property="Panel.ZIndex" Value="1" />
          <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowSplitter" TargetType="GridSplitter">
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="#393836" />
      <Setter Property="ResizeDirection" Value="Rows" />
      <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ToolTip" Value="Arrow keys resize" />
      <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Height" Value="12" />
          <Setter Property="Margin" Value="0,2,0,-2" />
          <Setter Property="Panel.ZIndex" Value="1" />
          <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidePanelColumn" Width="340" MinWidth="300" MaxWidth="440" />
      <ColumnDefinition x:Name="SidePanelSplitterColumn" Width="5" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="SidePanel"
            Grid.Column="0"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="0,0,1,0">
      <Grid Margin="18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
          <TextBlock FontSize="22"
                     FontWeight="SemiBold"
                     Text="Accessibility Recorder" />
          <TextBlock Margin="0,4,0,0"
                     Foreground="{StaticResource MutedText}"
                     TextWrapping="Wrap"
                     Text="Capture a session or open an existing recording." />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Button x:Name="OpenRecordingButton"
                    Margin="0,0,0,14"
                    HorizontalContentAlignment="Center"
                    Content="_Open recording..."
                    Click="OpenRecordingButton_Click" />

            <GroupBox Header="Capture channels" Padding="10" Margin="0,0,0,12">
              <StackPanel>
                <CheckBox x:Name="InputCheckBox"
                          IsChecked="True"
                          Content="_Keyboard and mouse input" />
                <CheckBox x:Name="AutomationCheckBox"
                          IsChecked="True"
                          Content="_UI Automation events" />
                <CheckBox x:Name="WindowCheckBox"
                          IsChecked="True"
                          Content="_Foreground window changes" />
                <CheckBox x:Name="FramesCheckBox"
                          IsChecked="True"
                          Content="_Desktop frames" />
                <CheckBox x:Name="MicrophoneCheckBox"
                          Content="_Microphone audio"
                          AutomationProperties.HelpText="Records speech and other sound from the default microphone." />
                <CheckBox x:Name="SystemAudioCheckBox"
                          Content="System _audio"
                          AutomationProperties.HelpText="Records audio rendered through the default Windows playback device, including screen reader speech." />
                <CheckBox x:Name="BrowserEvidenceCheckBox"
                          Content="_Instrumented Chromium evidence"
                          AutomationProperties.HelpText="Launches the recorder-owned instrumented Chromium build and records its browser evidence." />
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="BrowserCaptureGroupBox"
                      Header="Instrumented Chromium"
                      Padding="10"
                      Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Margin="0,0,0,8"
                           Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Text="Proof of concept: launch the current instrumented build and record the browser evidence it emits." />
                <Label Target="{Binding ElementName=ChromiumPathTextBox}"
                       Content="Chromium _executable:" />
                <TextBox x:Name="ChromiumPathTextBox"
                         Margin="0,0,0,8"
                         AutomationProperties.Name="Instrumented Chromium executable" />
                <Button x:Name="BrowseChromiumButton"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Content="_Browse for Chromium..."
                        Click="BrowseChromiumButton_Click" />
                <Label Target="{Binding ElementName=BrowserProfileTextBox}"
                       Content="Browser _profile folder:" />
                <TextBox x:Name="BrowserProfileTextBox"
                         Margin="0,0,0,8"
                         AutomationProperties.Name="Browser profile folder"
                         AutomationProperties.HelpText="Leave empty for a new profile for each recording, removed after it. Choose a prepared profile folder, such as one for a test account, to record with it. Only the listed accessibility preferences are recorded from it, not its browsing data." />
                <TextBlock Margin="0,0,0,8"
                           Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Text="Empty for a new profile for each recording. A prepared folder is kept, and only its accessibility preferences are recorded." />
                <Button x:Name="BrowseProfileButton"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Content="Browse for p_rofile folder..."
                        Click="BrowseProfileButton_Click" />
                <Label Target="{Binding ElementName=BrowserStartUrlTextBox}"
                       Content="Starting _website:" />
                <TextBox x:Name="BrowserStartUrlTextBox"
                         Text="about:blank"
                         AutomationProperties.Name="Starting website address"
                         AutomationProperties.HelpText="Enter an absolute website address, or about:blank." />
                <CheckBox x:Name="FullWalkCheckBox"
                          Margin="0,8,0,0"
                          Content="C_heck change records against a full walk"
                          AutomationProperties.HelpText="Walks each page in full every so many updates, so the change records can be compared with it. Slows the page while it walks." />
                <Label Target="{Binding ElementName=FullWalkIntervalTextBox}"
                       Content="Wa_lk every N updates:" />
                <TextBox x:Name="FullWalkIntervalTextBox"
                         Text="100"
                         IsEnabled="{Binding IsChecked, ElementName=FullWalkCheckBox}"
                         AutomationProperties.Name="Full walk interval in updates"
                         AutomationProperties.HelpText="A whole number from 1. Each page is walked in full at every Nth mutation delivery and every Nth rendering update." />
                <Button x:Name="OpenFixedRecreationButton"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Content="Open recreation with _fixed content"
                        AutomationProperties.HelpText="Opens a fixed test page in the instrumented Chromium with DevTools and the evidence panel. The page is written in code and is not evidence from a recording."
                        Click="OpenFixedRecreationButton_Click" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Playback event filters"
                      Padding="10"
                      Margin="0,0,0,12">
              <StackPanel>
                <UniformGrid Columns="2">
                  <CheckBox x:Name="FilterKeyboardCheckBox"
                            IsChecked="True"
                            Content="_Keyboard"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterMouseCheckBox"
                            IsChecked="True"
                            Content="_Mouse"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterAutomationCheckBox"
                            IsChecked="True"
                            Content="_UI Automation"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterWindowCheckBox"
                            IsChecked="True"
                            Content="_Window"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterPreferencesCheckBox"
                            IsChecked="True"
                            Content="Windows settings"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterMagnifierCheckBox"
                            IsChecked="True"
                            Content="Magnifier changes"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterBrowserSettingsCheckBox"
                            IsChecked="True"
                            Content="Browser settings"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterFramesCheckBox"
                            IsChecked="True"
                            Content="_Frames"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterMicrophoneCheckBox"
                            IsChecked="True"
                            Content="M_icrophone"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterSystemAudioCheckBox"
                            IsChecked="True"
                            Content="System _audio"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterMarkersCheckBox"
                            IsChecked="True"
                            Content="Mar_kers"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterBrowserCheckBox"
                            IsChecked="True"
                            Content="_Browser"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                  <CheckBox x:Name="FilterOtherCheckBox"
                            IsChecked="True"
                            Content="_Other"
                            Checked="TimelineFilter_Changed"
                            Unchecked="TimelineFilter_Changed" />
                </UniformGrid>
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                  <Button Margin="0,0,8,0"
                          Content="Select _all"
                          Click="SelectAllFiltersButton_Click" />
                  <Button Content="_Clear all"
                          Click="ClearAllFiltersButton_Click" />
                </StackPanel>
                <TextBlock x:Name="FilterSummaryTextBlock"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource MutedText}"
                           Text="No recording loaded."
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Storage" Padding="10" Margin="0,0,0,12">
              <StackPanel>
                <TextBox x:Name="OutputRootTextBox"
                         Margin="0,0,0,8"
                         AutomationProperties.Name="Session output folder" />
                <Button x:Name="BrowseButton"
                        HorizontalAlignment="Left"
                        Content="_Browse..."
                        Click="BrowseButton_Click" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Session marker" Padding="10" Margin="0,0,0,12">
              <StackPanel>
                <Label Target="{Binding ElementName=MarkerNoteTextBox}"
                       Content="Optional marker _note:" />
                <TextBox x:Name="MarkerNoteTextBox"
                         Margin="0,0,0,8" />
                <Button x:Name="MarkerButton"
                        HorizontalAlignment="Left"
                        Content="Add mark_er"
                        IsEnabled="False"
                        Click="MarkerButton_Click" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Current session" Padding="10">
              <StackPanel>
                <TextBlock x:Name="StatusTextBlock"
                           FontWeight="SemiBold"
                           Text="Ready to record."
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="DurationTextBlock"
                           Margin="0,6,0,0"
                           Text="Duration: 00:00:00" />
                <TextBlock x:Name="EvidenceTextBlock"
                           Margin="0,4,0,0"
                           Text="Events: 0 accepted, 0 dropped" />
                <TextBlock Margin="0,8,0,2" Text="Collector status:" />
                <ListBox x:Name="CollectorStatusListBox"
                         MaxHeight="110"
                         Background="#201F1D"
                         Foreground="#CDCCCA"
                         BorderBrush="{StaticResource PanelBorder}"
                         AutomationProperties.Name="Collector status"
                         IsTabStop="True" />
                <TextBlock Margin="0,8,0,2" Text="Session folder:" />
                <TextBox x:Name="SessionFolderTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Current session folder" />
                <Button x:Name="OpenFolderButton"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Content="_Open session folder"
                        IsEnabled="False"
                        Click="OpenFolderButton_Click" />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button x:Name="StartButton"
                  Grid.Column="0"
                  Margin="0,0,5,0"
                  Content="_Start recording"
                  Click="StartButton_Click" />
          <Button x:Name="StopButton"
                  Grid.Column="1"
                  Margin="5,0,0,0"
                  Content="S_top recording"
                  IsEnabled="False"
                  Click="StopButton_Click" />
        </Grid>
      </Grid>
    </Border>

    <GridSplitter x:Name="SidePanelSplitter"
                  Grid.Column="1"
                  Style="{StaticResource ColumnSplitter}"
                  AutomationProperties.Name="Resize recorder controls and playback" />

    <!-- The player: the video, then the region under it. While the details
         are shown, the splitter sets the region's height; otherwise the
         region takes the height of its controls. See
         docs/architecture/player-layout.md. -->
    <Grid x:Name="PlayerGrid" Grid.Column="2" Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="160" />
        <RowDefinition x:Name="LowerSplitterRow" Height="Auto" />
        <RowDefinition x:Name="LowerRegionRow" Height="Auto" />
      </Grid.RowDefinitions>

      <!-- The video and, to its right, the properties panel: the Magnifier
           readings of the frame shown and the Windows settings in effect.
           See docs/architecture/accessibility-preferences.md, "The
           properties panel". -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="240" />
          <ColumnDefinition x:Name="PropertiesSplitterColumn" Width="5" />
          <ColumnDefinition x:Name="PropertiesColumn" Width="480" MinWidth="220" MaxWidth="800" />
        </Grid.ColumnDefinitions>
      <Border Grid.Column="0"
              Background="Black"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1">
        <Grid>
          <Image x:Name="VideoImage"
                 Stretch="Uniform"
                 SnapsToDevicePixels="True"
                 AutomationProperties.Name="Recorded desktop video frame" />
          <TextBlock x:Name="VideoPlaceholderTextBlock"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="#A09F9B"
                     FontSize="18"
                     Text="Open a recording to begin playback." />
        </Grid>
      </Border>

        <GridSplitter x:Name="PropertiesSplitter"
                      Grid.Column="1"
                      Style="{StaticResource ColumnSplitter}"
                      KeyboardIncrement="20"
                      DragCompleted="PropertiesSplitter_DragCompleted"
                      LostKeyboardFocus="PropertiesSplitter_LostKeyboardFocus"
                      AutomationProperties.Name="Resize video and properties" />

        <GroupBox x:Name="PropertiesRegion"
                  Grid.Column="2"
                  Padding="4"
                  Header="Properties">
          <DockPanel>
          <TextBlock DockPanel.Dock="Bottom"
                     Margin="2,6,2,0"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource MutedText}"
                     Text="The buttons at the end of a row step through that setting's changes. The count is the change in effect, of all its changes from the start. Keys: Ctrl+Left and Ctrl+Right step; Enter goes to the change that set the value." />
          <ListView x:Name="PropertiesListView"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    PreviewKeyDown="PropertiesListView_PreviewKeyDown"
                    MouseDoubleClick="PropertiesListView_MouseDoubleClick"
                    AutomationProperties.Name="Properties at the frame shown"
                    AutomationProperties.HelpText="Each row reads setting, value, when it was set, and, for a setting that changed during the recording, which of its changes is in effect. Its previous and next change buttons, or Ctrl+Left and Ctrl+Right, move to the setting's previous and next change. Enter: the change that set the value.">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                <Setter Property="ToolTip" Value="{Binding Spoken}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Changed}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,6,0,2"
                               FontWeight="SemiBold"
                               Text="{Binding Name}" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Header="Setting" Width="120">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Setting}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Value" Width="110">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="When set" Width="80">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding WhenSetShown}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <!-- Previous and next change buttons and the count, on a
                     row whose setting changed during the recording. The
                     buttons are 44 by 44 pixels for head pointer and eye
                     tracking use, act on their own row, and do not take
                     focus; their keyboard equivalents are Ctrl+Left and
                     Ctrl+Right on the row. A disabled button still shows its
                     tooltip. The count has a fixed width, so the buttons do
                     not move as it changes. -->
                <GridViewColumn Header="Changes" Width="150">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal"
                                  Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibility}}">
                        <Button Style="{StaticResource PropertyChangeButton}"
                                Content="&#x25C0;"
                                IsEnabled="{Binding CanGoPrevious}"
                                Click="PropertyPreviousChange_Click"
                                ToolTip="{Binding PreviousName}"
                                AutomationProperties.Name="{Binding PreviousName}" />
                        <Button Style="{StaticResource PropertyChangeButton}"
                                Margin="4,0,0,0"
                                Content="&#x25B6;"
                                IsEnabled="{Binding CanGoNext}"
                                Click="PropertyNextChange_Click"
                                ToolTip="{Binding NextName}"
                                AutomationProperties.Name="{Binding NextName}" />
                        <TextBlock Margin="8,0,0,0"
                                   MinWidth="48"
                                   VerticalAlignment="Center"
                                   Text="{Binding CountShown}"
                                   ToolTip="{Binding CountSpoken}"
                                   AutomationProperties.Name="{Binding CountSpoken}" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          </DockPanel>
        </GroupBox>
      </Grid>

      <GridSplitter x:Name="LowerSplitter"
                    Grid.Row="1"
                    Style="{StaticResource RowSplitter}"
                    Visibility="Collapsed"
                    DragCompleted="LowerSplitter_DragCompleted"
                    AutomationProperties.Name="Resize video and details" />

      <Grid x:Name="LowerRegion" Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

      <Grid x:Name="TransportPanel" Grid.Row="0" Margin="0,12,0,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ToggleButton x:Name="SettingsToggle"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        IsChecked="True"
                        Content="Settings"
                        Click="SettingsToggle_Click"
                        AutomationProperties.Name="Settings"
                        AutomationProperties.AcceleratorKey="Ctrl+Shift+S"
                        AutomationProperties.HelpText="Shows or hides the recorder settings beside the player." />
          <ToggleButton x:Name="DetailsToggle"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        IsChecked="True"
                        Content="Details"
                        Click="DetailsToggle_Click"
                        AutomationProperties.Name="Details"
                        AutomationProperties.AcceleratorKey="Ctrl+Shift+D"
                        AutomationProperties.HelpText="Shows or hides the browser navigation and selected event values under the timeline." />
          <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ToggleButton x:Name="PropertiesToggle"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        IsChecked="True"
                        Content="Properties"
                        Click="PropertiesToggle_Click"
                        AutomationProperties.Name="Properties"
                        AutomationProperties.AcceleratorKey="Ctrl+Shift+P"
                        AutomationProperties.HelpText="Shows or hides the Magnifier readings and Windows settings at the frame shown, beside the video." />
          <ToggleButton x:Name="FrameOnlyToggle"
                        Margin="0,0,16,0"
                        Padding="8,0"
                        IsChecked="False"
                        IsEnabled="False"
                        Content="Frame only"
                        Click="FrameOnlyToggle_Click"
                        AutomationProperties.Name="Frame only"
                        AutomationProperties.AcceleratorKey="F11"
                        AutomationProperties.HelpText="Shows only the video, the playback controls, and the timeline. Press F11 or Escape to return." />
          </StackPanel>
          <Button x:Name="PreviousFrameButton"
                  Grid.Column="3"
                  Margin="0,0,8,0"
                  Content="Previous _frame"
                  IsEnabled="False"
                  Click="PreviousFrameButton_Click" />
          <Button x:Name="PlayPauseButton"
                  Grid.Column="4"
                  Margin="0,0,8,0"
                  MinWidth="90"
                  Content="_Play"
                  IsEnabled="False"
                  Click="PlayPauseButton_Click" />
          <Button x:Name="NextFrameButton"
                  Grid.Column="5"
                  Margin="0,0,12,0"
                  Content="_Next frame"
                  IsEnabled="False"
                  Click="NextFrameButton_Click" />
          <Slider x:Name="PlaybackSlider"
                  Grid.Column="6"
                  VerticalAlignment="Center"
                  Minimum="0"
                  Maximum="1"
                  IsEnabled="False"
                  IsMoveToPointEnabled="True"
                  ValueChanged="PlaybackSlider_ValueChanged"
                  AutomationProperties.Name="Recording position" />
          <TextBlock x:Name="PlaybackTimeTextBlock"
                     Grid.Column="7"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     FontFamily="Consolas"
                     Text="00:00:00.000 / 00:00:00.000"
                     AutomationProperties.LiveSetting="Off" />
          <Button x:Name="InspectPageButton"
                  Grid.Column="8"
                  Margin="12,0,0,0"
                  Content="Inspect pa_ge at this frame"
                  IsEnabled="False"
                  AutomationProperties.HelpText="Recreates a recorded page as it was at the frame shown, in the instrumented Chromium with DevTools and the evidence panel. No page script runs."
                  Click="InspectPageButton_Click" />
          <ToggleButton x:Name="WholeScreenToggle"
                        Grid.Column="9"
                        Margin="12,0,0,0"
                        Padding="8,0"
                        IsChecked="False"
                        IsEnabled="False"
                        Content="Whole screen"
                        Click="WholeScreenToggle_Click"
                        AutomationProperties.Name="Whole screen"
                        AutomationProperties.HelpText="No recording is open." />
        </Grid>

        <Grid x:Name="VolumePanel" Grid.Row="1" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0"
                 Padding="0,0,8,0"
                 VerticalContentAlignment="Center"
                 Target="{Binding ElementName=MicrophoneVolumeSlider}"
                 Content="_Microphone:" />
          <Slider x:Name="MicrophoneVolumeSlider"
                  Grid.Column="1"
                  Minimum="-36"
                  Maximum="0"
                  Value="0"
                  TickFrequency="3"
                  IsSnapToTickEnabled="True"
                  ValueChanged="AudioVolumeSlider_ValueChanged"
                  AutomationProperties.Name="Microphone playback gain" />
          <TextBlock x:Name="MicrophoneVolumeTextBlock"
                     Grid.Column="2"
                     Margin="8,0,0,0"
                     MinWidth="52"
                     VerticalAlignment="Center"
                     Text="0 dB" />
          <Label Grid.Column="4"
                 Padding="0,0,8,0"
                 VerticalContentAlignment="Center"
                 Target="{Binding ElementName=SystemAudioVolumeSlider}"
                 Content="S_ystem audio:" />
          <Slider x:Name="SystemAudioVolumeSlider"
                  Grid.Column="5"
                  Minimum="-36"
                  Maximum="0"
                  Value="0"
                  TickFrequency="3"
                  IsSnapToTickEnabled="True"
                  ValueChanged="AudioVolumeSlider_ValueChanged"
                  AutomationProperties.Name="System audio playback gain" />
          <TextBlock x:Name="SystemAudioVolumeTextBlock"
                     Grid.Column="6"
                     Margin="8,0,0,0"
                     MinWidth="52"
                     VerticalAlignment="Center"
                     Text="0 dB" />
        </Grid>
      </Grid>

      <Grid x:Name="TimelinePanel" Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="96" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                AutomationProperties.Name="Session event timeline">
          <local:SessionTimelineControl x:Name="TimelineControl"
                                        SelectedEventChanged="TimelineControl_SelectedEventChanged"
                                        LookupFailed="TimelineControl_LookupFailed"
                                        AutomationProperties.Name="Selectable session event timeline"
                                        AutomationProperties.HelpText="Click an event, or use Left, Right, Home, and End to move within a lane and Up and Down to move between lanes while focused, to inspect captured values." />
        </Border>
        <Grid Grid.Row="1" Margin="0,8,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0"
                 Padding="0,0,8,0"
                 VerticalContentAlignment="Center"
                 Target="{Binding ElementName=TimelineZoomSlider}"
                 Content="Timeline _zoom:" />
          <Slider x:Name="TimelineZoomSlider"
                  Grid.Column="1"
                  Minimum="1"
                  Maximum="32"
                  Value="1"
                  TickFrequency="1"
                  IsSnapToTickEnabled="True"
                  IsEnabled="False"
                  ValueChanged="TimelineZoomSlider_ValueChanged"
                  AutomationProperties.Name="Timeline zoom" />
          <TextBlock x:Name="TimelineZoomTextBlock"
                     Grid.Column="2"
                     Margin="8,0,12,0"
                     MinWidth="32"
                     VerticalAlignment="Center"
                     Text="1×" />
          <Button x:Name="FitTimelineButton"
                  Grid.Column="3"
                  Content="_Fit"
                  IsEnabled="False"
                  Click="FitTimelineButton_Click" />
        </Grid>
        <ScrollBar x:Name="TimelinePanScrollBar"
                   Grid.Row="2"
                   Orientation="Horizontal"
                   Minimum="0"
                   Maximum="0"
                   Value="0"
                   IsEnabled="False"
                   ValueChanged="TimelinePanScrollBar_ValueChanged"
                   AutomationProperties.Name="Timeline visible range start" />
      </Grid>

      <Grid x:Name="DetailsRegion" Grid.Row="2" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="300" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="3*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="0"
                  Padding="8"
                  Header="Browser navigation correlation">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel x:Name="BrowserNavigationFilterPanel"
                       Grid.Row="0"
                       Margin="0,0,0,6"
                       AutomationProperties.Name="Navigation kinds to list">
              <TextBlock Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Text="Show:" />
              <CheckBox x:Name="ShowPageNavigationsCheckBox"
                        Margin="0,0,12,0"
                        IsChecked="True"
                        Content="Pages"
                        Click="BrowserNavigationFilter_Click" />
              <CheckBox x:Name="ShowIframeNavigationsCheckBox"
                        Margin="0,0,12,0"
                        IsChecked="False"
                        Content="Iframes"
                        Click="BrowserNavigationFilter_Click" />
              <CheckBox x:Name="ShowBrowserUiNavigationsCheckBox"
                        Margin="0,0,12,0"
                        IsChecked="False"
                        Content="Browser UI"
                        Click="BrowserNavigationFilter_Click" />
              <CheckBox x:Name="ShowOtherFrameNavigationsCheckBox"
                        IsChecked="False"
                        Content="Other frames"
                        Click="BrowserNavigationFilter_Click" />
            </WrapPanel>
            <ListBox x:Name="BrowserNavigationListBox"
                     Grid.Row="1"
                     MinHeight="70"
                     DisplayMemberPath="Label"
                     SelectionChanged="BrowserNavigationListBox_SelectionChanged"
                     AutomationProperties.Name="Recorded browser navigations"
                     AutomationProperties.HelpText="Select a navigation to seek to it and inspect its correlated browser evidence." />
            <TextBox x:Name="BrowserCorrelationTextBox"
                     Grid.Row="2"
                     Margin="0,6,0,0"
                     MinHeight="70"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Browser navigation correlation summary"
                     Text="Open a recording with browser evidence to inspect navigation correlation." />
          </Grid>
        </GroupBox>
        <GridSplitter Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      AutomationProperties.Name="Resize browser correlation and event values" />
        <GroupBox Grid.Column="2"
                  Padding="8"
                  Header="Selected event values">
          <TextBox x:Name="EventDetailsTextBox"
                   MinHeight="70"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas"
                   AutomationProperties.Name="Selected event values"
                   Text="Select an event in the timeline to inspect its complete recorded values." />
        </GroupBox>
      </Grid>

      <Grid x:Name="StatusPanel" Grid.Row="3" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="BusyPanel"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
          <ProgressBar x:Name="BusyProgressBar"
                       Width="72"
                       Height="12"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Working"
                       AutomationProperties.HelpText="The recorder is busy. Please wait." />
          <TextBlock x:Name="BusyTextBlock"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock x:Name="PlaybackStatusTextBlock"
                   Grid.Column="1"
                   Foreground="{StaticResource MutedText}"
                   Text="No recording loaded."
                   TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Grid.Column="2"
                   Foreground="{StaticResource MutedText}"
                   Text="Keyboard | Mouse | UIA | Window | Frames | Mic | System audio" />
      </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
