<Window x:Class="Recorder.App.AndroidTalkBackExplorationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Recorder.App"
        Title="Explore with TalkBack"
        Width="670" Height="700" MinWidth="420" MinHeight="485"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <local:SelectableText TextWrapping="Wrap" IsTabStop="True"
        Text="Turn on TalkBack and focus an item in the app. Leave the phone untouched while scanning. The recorder sends navigation swipes only, but they can scroll or change the screen. To check the setup first, compare Verify one swipe with a physical right swipe from the same item." />
      <CheckBox x:Name="DefaultGestures" MinHeight="44" Margin="0,4,0,4" VerticalContentAlignment="Center"
                AutomationProperties.Name="On this phone, swiping right in TalkBack moves to the next item and swiping left moves to the previous item"
                Checked="DefaultGestures_Changed" Unchecked="DefaultGestures_Changed">
        <TextBlock TextWrapping="Wrap" Text="On this phone, swiping right in TalkBack moves to the next item and swiping left moves to the previous item." />
      </CheckBox>
      <local:SelectableText x:Name="ScanStatus" TextWrapping="Wrap" IsTabStop="True" FontWeight="SemiBold"
                            AutomationProperties.LiveSetting="Polite" Text="Ready to explore the current app screen." />
    </StackPanel>
    <DockPanel Grid.Row="1">
      <Label DockPanel.Dock="Top" Padding="0,0,0,4"
             Target="{Binding ElementName=Results}" Content="_Exploration results" />
      <TextBox x:Name="Results" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               Padding="6" AutomationProperties.Name="Exploration results"
               Text="No exploration results yet. A node that was not reached in this pass is not necessarily inaccessible." />
    </DockPanel>
    <WrapPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Right">
      <Button x:Name="VerifyButton" MinHeight="44" Padding="12,0" Margin="0,0,8,0"
              Content="_Verify one swipe" Click="Verify_Click" IsEnabled="False" />
      <Button x:Name="StartButton" MinHeight="44" Padding="12,0" Margin="0,0,8,0"
              Content="_Start exploration" Click="Start_Click" IsEnabled="False" />
      <Button x:Name="StopButton" MinHeight="44" Padding="12,0" Margin="0,0,8,0"
              Content="S_top exploration" Click="Stop_Click" IsEnabled="False" />
      <Button MinHeight="44" Padding="12,0" Content="_Close" Click="Close_Click" />
    </WrapPanel>
  </Grid>
</Window>
