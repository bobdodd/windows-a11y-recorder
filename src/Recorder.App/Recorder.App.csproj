<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Server garbage collection collects on one thread per processor, so
         the pauses that stop every thread of the app, including the threads
         receiving evidence, are shorter. With workstation collection, one
         browser recording and its writing paused the app for 12.5 seconds
         in total over 131 seconds. See docs/architecture/session-database.md. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Recorder.Coordinator/Recorder.Coordinator.csproj" />
    <ProjectReference Include="../Recorder.Database/Recorder.Database.csproj" />
    <ProjectReference Include="../Recorder.Session/Recorder.Session.csproj" />
    <ProjectReference Include="../Recorder.WindowsCapture/Recorder.WindowsCapture.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <!-- The PostgreSQL server the app runs as its database, fetched into the
       repository by scripts/Get-PostgresBinaries.ps1 and copied to pgsql in
       the output folder. Without it the app cannot record or open
       recordings, and says so when it starts. -->
  <PropertyGroup>
    <PostgresBinariesRoot>$(MSBuildThisFileDirectory)..\..\.postgres\pgsql\</PostgresBinariesRoot>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(PostgresBinariesRoot)bin\postgres.exe')">
    <None Include="$(PostgresBinariesRoot)**\*"
          LinkBase="pgsql"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
</Project>
