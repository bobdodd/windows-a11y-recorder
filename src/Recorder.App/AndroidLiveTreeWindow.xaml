<Window x:Class="Recorder.App.AndroidLiveTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Recorder.App"
        Title="Live Android accessibility tree"
        Width="880" Height="650" MinWidth="480" MinHeight="390"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
    <Style x:Key="FocusGlyph" TargetType="Shape">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Margin" Value="0,3,6,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="AccessibilityFocusGlyph" TargetType="Ellipse" BasedOn="{StaticResource FocusGlyph}">
      <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
      <Setter Property="Stroke" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
    </Style>
    <Style x:Key="InputFocusGlyph" TargetType="Rectangle" BasedOn="{StaticResource FocusGlyph}">
      <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
      <Setter Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,6">
      <local:SelectableText TextWrapping="Wrap"
                            Text="View only. These are Android’s latest observed accessibility snapshots, not a transcript or a frame-synchronized tree." />
      <WrapPanel Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
          <Ellipse Style="{StaticResource AccessibilityFocusGlyph}" />
          <local:SelectableText Text="Accessibility focus (screen reader)" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <Rectangle Style="{StaticResource InputFocusGlyph}" />
          <local:SelectableText Text="Input focus (keyboard)" TextWrapping="Wrap" />
        </StackPanel>
      </WrapPanel>
    </StackPanel>
    <local:SelectableText x:Name="TreeStatus" Grid.Row="1" Margin="0,0,0,8"
                          TextWrapping="Wrap" FontWeight="SemiBold"
                          AutomationProperties.LiveSetting="Polite" />
    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Label VerticalAlignment="Center" Target="{Binding ElementName=WindowPicker}" Content="_Phone window:" />
      <ComboBox x:Name="WindowPicker" Grid.Column="1" MinHeight="44" Margin="4,0,8,0"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="Phone window"
                SelectionChanged="WindowPicker_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button x:Name="PauseButton" Grid.Column="2" MinHeight="44" MinWidth="120" Padding="8,0"
              Content="_Pause updates" Click="PauseButton_Click"
              AutomationProperties.HelpText="Keeps this tree still for inspection without pausing the video or recording." />
    </Grid>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="165" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="6*" MinWidth="165" />
      </Grid.ColumnDefinitions>
      <TreeView x:Name="NodeTree" SelectedItemChanged="NodeTree_SelectedItemChanged"
                AutomationProperties.Name="Android accessibility nodes"
                AutomationProperties.HelpText="Accessibility focus follows the screen reader. Input focus receives keyboard input. Both are separate from the row you select. Expand or collapse nodes with the arrow keys. The selected node’s reported properties are in Node details."
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                HorizontalContentAlignment="Stretch">
        <TreeView.ItemContainerStyle>
          <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleCaption}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Margin="5,2,3,2">
              <local:SelectableText x:Name="RowText" Text="{Binding Caption, Mode=OneWay}"
                                    TextWrapping="Wrap" VerticalAlignment="Center" />
              <DockPanel Visibility="{Binding HasAccessibilityFocus, Converter={StaticResource ShowWhenTrue}}">
                <Ellipse DockPanel.Dock="Left" Style="{StaticResource AccessibilityFocusGlyph}" />
                <local:SelectableText Text="{Binding AccessibilityFocusLabel, Mode=OneWay}"
                                      TextWrapping="Wrap" FontWeight="SemiBold" />
              </DockPanel>
              <DockPanel Visibility="{Binding HasInputFocus, Converter={StaticResource ShowWhenTrue}}">
                <Rectangle DockPanel.Dock="Left" Style="{StaticResource InputFocusGlyph}" />
                <local:SelectableText Text="{Binding InputFocusLabel, Mode=OneWay}"
                                      TextWrapping="Wrap" FontWeight="SemiBold" />
              </DockPanel>
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
              <DataTrigger Binding="{Binding HasPhoneFocus}" Value="True">
                <Setter TargetName="RowText" Property="FontWeight" Value="Bold" />
              </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    Background="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
                    AutomationProperties.Name="Resize tree and details" />
      <DockPanel Grid.Column="2">
        <Label DockPanel.Dock="Top" Padding="0,0,0,4"
               Target="{Binding ElementName=NodeDetails}" Content="_Node details" />
        <TextBox x:Name="NodeDetails" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Padding="6" AutomationProperties.Name="Node details" />
      </DockPanel>
    </Grid>
    <Button x:Name="CloseButton" Grid.Row="4" Margin="0,8,0,0"
            MinHeight="44" MinWidth="100" HorizontalAlignment="Right"
            Content="_Close" Click="CloseButton_Click" />
  </Grid>
</Window>
