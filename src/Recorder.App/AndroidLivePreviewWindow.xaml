<Window x:Class="Recorder.App.AndroidLivePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Recorder.App"
        Title="Live Android preview"
        Width="480" Height="740"
        MinWidth="300" MinHeight="290"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <Style TargetType="{x:Type local:SelectableText}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="IsTabStop" Value="True" />
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style TargetType="{x:Type Control}">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                  <Rectangle Margin="-3" StrokeThickness="2"
                             Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                             SnapsToDevicePixels="True" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <local:SelectableText Text="The picture does not send input. To investigate TalkBack navigation, open Explore with TalkBack. The preview may lag when capture is busy." />
      <local:SelectableText x:Name="PreviewStatus"
                            Margin="0,6,0,0" FontWeight="SemiBold"
                            AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <Border Grid.Row="1" Background="Black" ClipToBounds="True">
      <Image x:Name="PhoneImage" Stretch="Uniform" IsHitTestVisible="False"
             AutomationProperties.Name="Live Android phone screen" />
    </Border>
    <WrapPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
      <Button x:Name="TreeButton" MinHeight="44" Padding="12,0" Margin="0,0,8,0"
              Content="_Accessibility tree..." Click="TreeButton_Click"
              AutomationProperties.HelpText="Opens the Android accessibility tree observed during recording." />
      <Button x:Name="ExploreButton" MinHeight="44" Padding="12,0" Margin="0,0,8,0"
              Content="_Explore with TalkBack..." Click="ExploreButton_Click"
              AutomationProperties.HelpText="Opens the setup and results for scanning the current app screen with TalkBack." />
      <Button x:Name="CloseButton" MinHeight="44" MinWidth="110"
              Content="_Close preview" Click="CloseButton_Click" />
    </WrapPanel>
  </Grid>
</Window>
