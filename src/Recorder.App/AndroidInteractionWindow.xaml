<Window x:Class="Recorder.App.AndroidInteractionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Recorder.App"
        Title="Screen interactivity report" Width="730" Height="650" MinWidth="390" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <local:SelectableText x:Name="RunStatus" Margin="0,0,0,10" TextWrapping="Wrap" IsTabStop="True"
                          FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
    <TextBox Grid.Row="1" x:Name="Report" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="9"
             AutomationProperties.Name="Screen interactivity report" />
    <Button Grid.Row="2" x:Name="CloseReport" Margin="0,10,0,0" MinHeight="44" Padding="14,0"
            HorizontalAlignment="Right" Content="_Stop investigation" Click="Close_Click" />
  </Grid>
</Window>
