<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../Recorder.Database/Recorder.Database.csproj" />
    <!-- The page recreated at a moment, for the summary with vision. -->
    <ProjectReference Include="../Recorder.Recreation/Recorder.Recreation.csproj" />
  </ItemGroup>
  <!-- The models the setup window offers, beside the programs, so the list
       can be read and changed without a new build. -->
  <ItemGroup>
    <None Include="Setup/model-catalog.json"
          Link="model-catalog.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The Android report's fixed text for each check (android-report.md),
       in the program so the report and its SHA-256 come from one file. -->
  <ItemGroup>
    <EmbeddedResource Include="Android/android-check-guidance.json"
                      LogicalName="Recorder.Analysis.Android.android-check-guidance.json" />
  </ItemGroup>
  <!-- Writes the Android report as a Word document (android-report.md). -->
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Recorder.Tests" />
  </ItemGroup>
</Project>
