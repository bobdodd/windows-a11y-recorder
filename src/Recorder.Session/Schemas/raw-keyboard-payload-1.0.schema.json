{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.windows-a11y-recorder.local/raw-keyboard-payload-1.0.schema.json",
  "title": "Windows Raw Input keyboard payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviceHandle",
    "makeCode",
    "flags",
    "virtualKey",
    "message",
    "extraInformation"
  ],
  "properties": {
    "deviceHandle": { "type": "integer" },
    "makeCode": { "type": "integer", "minimum": 0 },
    "flags": { "type": "integer", "minimum": 0 },
    "virtualKey": { "type": "integer", "minimum": 0 },
    "message": { "type": "integer", "minimum": 0 },
    "extraInformation": { "type": "integer", "minimum": 0 }
  }
}
