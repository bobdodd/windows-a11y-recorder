{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.windows-a11y-recorder.local/collector-lifecycle-payload-1.0.schema.json",
  "title": "Collector lifecycle payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "state", "utc"],
  "properties": {
    "action": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "minLength": 1 },
    "utc": { "type": "string", "format": "date-time" }
  }
}
