{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.windows-a11y-recorder.local/collector-omission-payload-1.0.schema.json",
  "title": "Collector omission payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason"],
  "properties": {
    "reason": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "stream": { "enum": ["microphone", "system"] },
    "firstDroppedAtNanoseconds": { "type": "integer", "minimum": 0 },
    "lastDroppedAtNanoseconds": { "type": "integer", "minimum": 0 },
    "droppedByObservationType": {
      "type": "object",
      "propertyNames": {
        "enum": ["focus-changed", "automation-event", "structure-changed", "property-changed"]
      },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    }
  },
  "dependentRequired": {
    "firstDroppedAtNanoseconds": ["count", "lastDroppedAtNanoseconds", "droppedByObservationType"],
    "lastDroppedAtNanoseconds": ["count", "firstDroppedAtNanoseconds", "droppedByObservationType"],
    "droppedByObservationType": ["count", "firstDroppedAtNanoseconds", "lastDroppedAtNanoseconds"]
  }
}
