{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.windows-a11y-recorder.local/desktop-frame-payload-1.0.schema.json",
  "title": "Desktop frame payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "x",
    "y",
    "width",
    "height",
    "stride",
    "pixelFormat",
    "encodedFormat",
    "byteLength",
    "captureDurationNanoseconds",
    "framesPerSecond",
    "backend",
    "monitorCount",
    "fallbackReason",
    "gdiFallbackFrameCount"
  ],
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\]+$"
    },
    "x": { "type": "integer" },
    "y": { "type": "integer" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "stride": { "type": "integer", "minimum": 1 },
    "pixelFormat": { "type": "string", "minLength": 1 },
    "encodedFormat": { "type": "string", "minLength": 1 },
    "byteLength": { "type": "integer", "minimum": 0 },
    "captureDurationNanoseconds": { "type": "integer", "minimum": 0 },
    "framesPerSecond": { "type": "integer", "minimum": 1 },
    "backend": { "enum": ["windows-graphics-capture", "gdi-bitblt"] },
    "monitorCount": { "type": ["integer", "null"], "minimum": 0 },
    "fallbackReason": { "type": ["string", "null"] },
    "gdiFallbackFrameCount": { "type": "integer", "minimum": 0 },
    "frameSelection": {
      "description": "Which arrived WGC frame each monitor image comes from. newest-arrived: the recorder releases every arrived frame except the newest and copies that one at the poll. Absent in archives written before it was recorded, whose images are the oldest queued frame; null for GDI fallback frames.",
      "enum": ["newest-arrived", null]
    },
    "monitorFrames": {
      "description": "Per-monitor composition timing. Absent in archives written before it was recorded; timing fields are null for GDI fallback frames.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "monitorHandle",
          "x",
          "y",
          "width",
          "height",
          "systemRelativeTimeTicks",
          "compositedAtNanoseconds",
          "dequeuedAtNanoseconds",
          "tryGetNextFrameAttempts"
        ],
        "properties": {
          "monitorHandle": { "type": "integer" },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "systemRelativeTimeTicks": { "type": ["integer", "null"], "minimum": 1 },
          "compositedAtNanoseconds": { "type": ["integer", "null"] },
          "dequeuedAtNanoseconds": { "type": ["integer", "null"] },
          "tryGetNextFrameAttempts": { "type": ["integer", "null"], "minimum": 1 },
          "supersededFrameCount": {
            "description": "Arrived frames released without being copied since the previous capture of this monitor. Present when frameSelection is newest-arrived.",
            "type": ["integer", "null"],
            "minimum": 0
          },
          "reusedPreviousImage": {
            "description": "True when no frame arrived since the previous capture, so the previous image was copied again with its original timing. Present when frameSelection is newest-arrived.",
            "type": ["boolean", "null"]
          }
        }
      }
    }
  }
}
